# The analytics host's generate step, run by the rule pronto/analytics.cue adds, after pronto's
# writer. Written by pronto-analytics; regenerated, do not edit.

const begin = "  # pronto-analytics:begin — the tracker's two addresses, to Umami"
const end = "  # pronto-analytics:end"

# A file rewritten only when its text changes, so a generate that changes nothing leaves every
# watch and build cache where it was.
def save-changed [path: path] {
	let text = $in
	if not ($path | path exists) or (open --raw $path) != $text {
		mkdir ($path | path dirname)
		# Replaced in one rename: a reader (a gate beside a stack's generate) never sees it half-written.
		let tmp = $"($path).($nu.pid).tmp"
		$text | save --force --raw $tmp
		mv --force $tmp $path
	}
}

# The door's routes to Umami, which pronto's writer regenerates without them: the tracker and its
# collector, and nothing else of Umami (its console has its own address). An earlier run's go
# first, so a changed address replaces the old one. Umami answers at the very paths, which its
# TRACKER_SCRIPT_NAME and COLLECT_API_ENDPOINT name. On a host launch (a request for localhost) the
# upstream is the stand-in, the door's PRONTO_UPSTREAM_UMAMI (the launch sets it to the peer's
# address; umami:8697 is its address in a container); anywhere else it is Umami at `upstream`, which is
# not a peer of the release (the operator's state runs it, not the app's release). Neither gets the
# app's cookies, authorization or referrer: Umami is told the page and its referrer by the tracker.
export def route [script: string, collect: string, upstream: string] {
	let proxy = [
		"    @local host localhost 127.0.0.1"
		"    route {"
		"      reverse_proxy @local {$PRONTO_UPSTREAM_UMAMI:umami:8697} {"
		"        header_up -Cookie"
		"        header_up -Authorization"
		"        header_up -Referer"
		"      }"
		$"      reverse_proxy ($upstream) {"
		"        header_up Host {upstream_hostport}"
		"        header_up -Cookie"
		"        header_up -Authorization"
		"        header_up -Referer"
		"      }"
		"    }"
	]
	let route = [
		$begin
		$"  handle ($script) {"
		...$proxy
		"  }"
		$"  handle ($collect) {"
		# An event is a few hundred bytes.
		"    request_body {"
		"      max_size 16KB"
		"    }"
		...$proxy
		"  }"
		$end
	]
	let all = open --raw docker/Caddyfile | lines
	let from = $all | enumerate | where item == $begin | get index.0?
	let to = $all | enumerate | where item == $end | get index.0?
	let lines = if $from == null or $to == null { $all } else { [...($all | first $from) ...($all | skip ($to + 1))] }
	let at = $lines | enumerate | where {|l| $l.item | str starts-with "  handle /auth/*"} | get index.0?
	if $at == null { error make {msg: "docker/Caddyfile has no `handle /auth/*` to place the analytics routes before"} }
	# Another host's block ends with its end marker, which is no comment of this route's.
	let start = $at - ($lines | first $at | reverse | take while {|l| ($l | str starts-with "  #") and not ($l | str ends-with ":end")} | length)
	[...($lines | first $start) ...$route ...($lines | skip $start)] | str join "\n" | $"($in)\n" | save-changed docker/Caddyfile
}

# The program's `analytics.out`, as `cue export -e analytics.out --out json` gives it: the views
# beside the program (analytics/views.sql, a raw migration), the loader's settings beside its
# module, the rest into observability/, raw where the spec wrote text and JSON where an object.
export def write [] {
	let out = $in | from json
	for f in ($out | columns) {
		let value = $out | get $f
		if $f == "analytics.views.sql" {
			$value | save-changed analytics/views.sql
		} else if $f == "analytics.loader.json" {
			$"// generated by pronto-analytics from the app's analytics_spec.cue — do not edit\nexport default ($value | to json --raw);\n" | save-changed shell/hatches/analytics/config.js
		} else {
			(if ($value | describe) == "string" { $value } else { $value | to json --indent 2 }) | save-changed $"observability/($f)"
		}
	}
}

# The exporter on a host, as process-compose runs it: the stack's database as the read-only role
# the views make, on the port the launch gave it (a slot's, else the stack's own, which
# .bayt/process-compose.yaml names).
export def exporter [package: string] {
	let port = $env.DATABASE_PG_PORT? | default (open --raw .bayt/process-compose.yaml | parse --regex 'DATABASE_PG_PORT:-(?<p>[0-9]+)' | get p.0)
	let db = $env.POSTGRES_DB? | default $package
	$env.SQLEXPORTER_TARGET_DSN = $"postgres://analytics_reader:dev-analytics-password@127.0.0.1:($port)/($db)?sslmode=disable"
	exec sql_exporter -config.file observability/analytics.sql_exporter.yml -web.listen-address $"127.0.0.1:($env.ANALYTICS_METRICS_PORT? | default '9399')"
}

# What the exporter answers: each business metric's samples. Reads its metrics port (the launch's,
# or `url`).
export def report [url?: string] {
	let at = $url | default $"http://127.0.0.1:($env.ANALYTICS_METRICS_PORT? | default '9399')/metrics"
	http get --raw $at | lines | where {|l| $l | str starts-with "business_"}
}
