// The pronto-probe host: journeys run against a released app on a schedule, an alert naming the
// flag writes just before the first failure (README.md). The driver and its rules are written
// into the app as probe/; the schema joins the app's package, and the app's own probes_spec.cue
// (seeded once) holds its journeys.
@extern(embed)

package probe

import "strings"

_schema: _ @embed(file="schema.cue", type=text)
_driver: _ @embed(file="probe.ts", type=text)
_rules:  _ @embed(file="probe.js", type=text)

#Host: H={
	// The program's CUE package, which the schema joins.
	package!: =~"^[a-z][a-z0-9_]*$"

	_header: "// generated by pronto-probe from probe/host.cue — do not edit\n"

	files: {
		"probe/probe.ts": {seed: false, text: _driver}
		"probe/probe.js": {seed: false, text: _rules}
		"probes_plugin.cue": {
			seed: false
			text: H._header + strings.Replace(_schema, "\npackage probe\n", "\npackage \(H.package)\n", 1)
		}
		"probes_spec.cue": {
			seed: true
			text: """
				package \(H.package)

				// The journeys pronto-probe runs against the released app, and where.
				probeTarget: url: "https://example.com"
				probes: {
					// home: {journey: [{name: "home", path: "/"}]}
				}

				"""
		}
	}
}
