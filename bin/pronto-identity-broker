#!/bin/sh
# Runs the identity broker an operator serves for every pronto-identity app:
#   bin/pronto-identity-broker [env-file]
# The env file (default ~/.config/pronto-identity/broker.env, never committed)
# holds BROKER_ISSUER, BROKER_SECRET and each provider's client, e.g.
# GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET; PORT defaults to 28443.
# Or releases it to Cloud Run, as identity/release.nu says:
#   bin/pronto-identity-broker release --project P --domain D --google-client-id C
set -eu
here=$(cd "$(dirname "$0")/.." && pwd)
cd "$here"
if [ "${1:-}" = release ]; then
	shift
	exec ./saytw --script tools.nu nu identity/release.nu "$@"
fi
env_file=${1:-$HOME/.config/pronto-identity/broker.env}
[ -f "$env_file" ] || { echo "pronto-identity-broker: no $env_file" >&2; exit 2; }
# Deno as CI pins it for the plugins tree (.github/workflows/ci.yml).
exec ./saytw --script tools.nu mise exec deno@2.5.0 -- deno run --no-config --allow-net --allow-env --env-file="$env_file" identity/broker/main.ts
