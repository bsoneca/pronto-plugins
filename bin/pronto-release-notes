#!/bin/sh
# Adds or refreshes release-notes in a pronto app: after a release goes live, a GitHub Release on
# the app's repo, tagged <app>/<revision> (release-notes/README.md).
#   bin/pronto-release-notes <app-dir>
# Writes release-notes/ (the driver and its rules) and release_notes_plugin.cue (the schema, in the
# app's package), both regenerated; the app's own release_notes.cue is optional and never written.
set -eu
here=$(cd "$(dirname "$0")/.." && pwd)
app=$(cd "$1" && pwd)
shift
[ $# -eq 0 ] || { echo "pronto-release-notes: unknown argument $1" >&2; exit 2; }
package=$(sed -n 's/^package[[:space:]]\{1,\}\([a-z][a-z0-9_]*\)[[:space:]]*$/\1/p' "$app/program.cue" | head -n 1)
[ -n "$package" ] || { echo "pronto-release-notes: $app/program.cue names no package" >&2; exit 2; }
files=$(mktemp)
trap 'rm -f "$files"' EXIT
cd "$here"
./saytw --script tools.nu cue export ./release-notes/export -t "package=$package" -e files --out json > "$files"
./saytw --script tools.nu nu bin/write.nu "$files" "$app"
