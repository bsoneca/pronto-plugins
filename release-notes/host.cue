// The release-notes host: after an app's release goes live, a GitHub Release on the app's repo,
// tagged <app>/<revision> (README.md). The driver and its rules are this host's, written into the
// app as release-notes/; the schema joins the app's package. Nothing is seeded: the app's own
// release_notes.cue is optional, its defaults being what the app has nothing to say about.
@extern(embed)

package releasenotes

import "strings"

_schema: _ @embed(file="schema.cue", type=text)
_driver: _ @embed(file="release-notes.ts", type=text)
_rules:  _ @embed(file="notes.js", type=text)

#Host: H={
	// The program's CUE package, which the schema joins.
	package!: =~"^[a-z][a-z0-9_]*$"

	_header: "// generated by pronto-release-notes from release-notes/host.cue — do not edit\n"

	files: {
		"release-notes/release-notes.ts": {seed: false, text: _driver}
		"release-notes/notes.js": {seed: false, text: _rules}
		"release_notes_plugin.cue": {
			seed: false
			text: H._header + strings.Replace(_schema, "\npackage releasenotes\n", "\npackage \(H.package)\n", 1)
		}
	}
}
