# The errors host's generate step, run by the rules pronto/errors.cue adds. Written by
# pronto-errors; regenerated, do not edit.

const begin = "  # pronto-errors:begin — the pages' error reports, to GlitchTip's ingest"
const end = "  # pronto-errors:end"

# A file rewritten only when its text changes, so a generate that changes nothing leaves every
# watch and build cache where it was.
def save-changed [path: path] {
	let text = $in
	if not ($path | path exists) or (open --raw $path) != $text {
		mkdir ($path | path dirname)
		# Replaced in one rename: a reader (a gate beside a stack's generate) never sees it half-written.
		let tmp = $"($path).($nu.pid).tmp"
		$text | save --force --raw $tmp
		mv --force $tmp $path
	}
}

# The door's route for the pages' reports, which pronto's writer regenerates without it:
# `<prefix>/api/*`, and nothing else of GlitchTip. The prefix is stripped, since GlitchTip answers at
# /api/<project>/envelope/. An earlier run's block goes first, so a changed address replaces the old
# one. On a host launch (a request for localhost) the upstream is the stand-in, the door's
# PRONTO_UPSTREAM_ERRORS (the launch sets it to the peer's address; errors:8700 is its address in a
# container); anywhere else it is GlitchTip at `upstream`, which is not a peer of the release (the
# operator's cluster runs it). Neither learns who sent a report: the cookies, the authorization, the
# referrer and every header that carries the sender's address are dropped, so GlitchTip never holds
# a player's IP. A report is a few kilobytes: the body is capped at 64KB.
export def route [prefix: string, upstream: string] {
	let dropped = [
		"        header_up -Cookie"
		"        header_up -Authorization"
		"        header_up -Referer"
		"        header_up -X-Forwarded-For"
		"        header_up -X-Real-Ip"
		"        header_up -Forwarded"
		"        header_up -Cf-Connecting-Ip"
	]
	let route = [
		$begin
		$"  handle ($prefix)/api/* {"
		"    request_body {"
		"      max_size 64KB"
		"    }"
		$"    uri strip_prefix ($prefix)"
		"    @local host localhost 127.0.0.1"
		"    route {"
		"      reverse_proxy @local {$PRONTO_UPSTREAM_ERRORS:errors:8700} {"
		...$dropped
		"      }"
		$"      reverse_proxy ($upstream) {"
		"        header_up Host {upstream_hostport}"
		...$dropped
		"      }"
		"    }"
		"  }"
		$end
	]
	let all = open --raw docker/Caddyfile | lines
	let from = $all | enumerate | where item == $begin | get index.0?
	let to = $all | enumerate | where item == $end | get index.0?
	let lines = if $from == null or $to == null { $all } else { [...($all | first $from) ...($all | skip ($to + 1))] }
	let at = $lines | enumerate | where {|l| $l.item | str starts-with "  handle /auth/*"} | get index.0?
	if $at == null { error make {msg: "docker/Caddyfile has no `handle /auth/*` to place the errors route before"} }
	# Another host's block ends with its end marker, which is no comment of this route's.
	let start = $at - ($lines | first $at | reverse | take while {|l| ($l | str starts-with "  #") and not ($l | str ends-with ":end")} | length)
	[...($lines | first $start) ...$route ...($lines | skip $start)] | str join "\n" | $"($in)\n" | save-changed docker/Caddyfile
}

# The program's `errors.out`, as `cue export -e errors.out --out json` gives it: the reporter's
# settings beside its module.
export def write [] {
	let out = $in | from json
	for f in ($out | columns) {
		let value = $out | get $f
		if $f == "errors.loader.json" {
			$"// generated by pronto-errors from the app's errors_spec.cue — do not edit\nexport default ($value | to json --raw);\n" | save-changed shell/hatches/errors/config.js
		} else {
			error make {msg: $"errors write: no place for ($f)"}
		}
	}
}
