// The analytics host: the operator's view of an app's business, on unmodified pronto. An app
// declares business metrics as SQL over its own tables; the host derives read-only views, an
// exporter that publishes them as Prometheus metrics (business_*, apart from journeys' and perf's
// and never alerting), a Grafana dashboard, and the door's routes to Umami for visits and
// referrers, with the hatch that loads its tracker. Where it all runs in production is
// pronto-infra's state; this host writes what the app owns.
//
// pronto has no analytics, so the host holds generated files, as the journeys and perf hosts do:
// a seat beside pronto/config.cue's, the schema in the app's own package, and the step its
// generate runs after pronto's writer.
@extern(embed)

package analytics

import (
	"encoding/json"
	"strings"
)

_schema:      _ @embed(file="schema.cue", type=text)
_analyticsNu: _ @embed(file="analytics.nu", type=text)
_loaderJs:    _ @embed(file="analytics.js", type=text)
_standinTs:   _ @embed(file="standin.ts", type=text)

_loaderPath: "shell/hatches/analytics/analytics.js"
_configPath: "shell/hatches/analytics/config.js"

#Tools: {
	// The exporter on a host. A host launch's Umami is the stand-in (deno, which the app has).
	"github:burningalchemist/sql_exporter": #AnalyticsExporterVersion
}

#Host: H={
	// The program's CUE package, which the schema joins.
	package!: =~"^[a-z][a-z0-9_]*$"
	// Whether the app has journeys, whose alerts must never read a business metric.
	journeys: *true | bool

	_header:    "// generated by pronto-analytics from analytics/host.cue — do not edit\n"
	_unalerted: string
	if H.journeys {_unalerted: "_analyticsUnalerted: (#AnalyticsUnalerted & {alerts: journeys.alerts}).offending"}
	if !H.journeys {_unalerted: "// (no journeys: nothing here to alert)"}
	_step: "use ./analytics/analytics.nu"

	// The generate rules. The program's `analytics.out` is written out before pronto's writer
	// (priority -1, as the spec step of an app's own facts is), since the views are a raw migration
	// that writer copies. The door it rewrites is given the routes after it and after the journeys'
	// and perf's (3), whose older route step takes a block just above the auth route for its own
	// comment and would nest inside this one.
	_write: {
		priority: -1
		cmds: [{do: "use tools.nu [run-mise]; \(H._step); run-mise exec -- cue export . -e analytics.out --out json | analytics write"}]
	}
	_route: {
		priority: 3
		cmds: [{do: "use tools.nu [run-mise]; \(H._step); let u = (run-mise exec -- cue export . -e analytics.umami --out json | from json); analytics route $u.script $u.collect $u.upstream"}]
	}

	files: {
		"pronto/analytics.cue": {
			seed: false
			text: H._header + """
				package prontoproject

				pronto: {
					tools: \(json.Marshal(#Tools))
					say: say: generate: rulemap: {
						"analytics-write": \(json.Marshal(H._write))
						"analytics-route": \(json.Marshal(H._route))
					}
				}

				"""
		}
		"analytics_plugin.cue": {
			seed: false
			text: H._header + strings.Replace(_schema, "\npackage analytics\n", "\npackage \(H.package)\n", 1)
		}
		// The app's own: its metrics and panels. Not analytics.cue: sayt's lint vets an X.cue
		// against a path X, and analytics/ is this host's.
		"analytics_spec.cue": {
			seed: true
			text: """
				package \(H.package)

				// What this app's operator reads: metrics as SQL over the app's tables (a SELECT of
				// the labels and a numeric `value`), and the panels that draw them. Names start
				// `business_`, a counter ends `_total`; none is a journey's, and none alerts.
				//
				//	analytics: #Analytics & {
				//		app: "\(H.package)"
				//		metrics: business_accounts: {help: "Accounts.", labels: [], select: "SELECT count(*) AS value FROM app_user"}
				//		rows: [{title: "People", panels: [{title: "Accounts", expr: "business_accounts{app=\\"$app\\"}"}]}]
				//	}
				analytics: #Analytics & {app: "\(H.package)"}

				"""
		}
		"analytics/analytics.nu": {seed: false, text: _analyticsNu}
		"analytics/standin.ts": {seed: false, text: _standinTs}
		// The views and role as a raw migration (list it in code: state: rawMigrations), empty until
		// the first generate writes the app's.
		"analytics/views.sql": {seed: true, text: "-- Written by pronto-analytics from analytics_spec.cue: change that, never this.\n"}
		(_loaderPath): {seed: false, text: _loaderJs}
		(_configPath): {
			seed: true
			text: "// generated by pronto-analytics from the app's analytics_spec.cue — do not edit\nexport default \(json.Marshal({website: "", script: "/a/s.js"}));\n"
		}
		"analytics_hatch.cue": {
			seed: false
			text: H._header + """
				package \(H.package)

				import (
					"list"
					"strings"
				)

				// The tracker's loader: a host-DOM hatch on every screen (analytics.js). A screen with
				// hatches of its own names it among them, and the app lists the screen in
				// _analyticsOwnHatches so this does not; vet lists any screen left without it.
				code: capabilities: hatches: analytics: {
					kind:  "host-dom"
					src:   "\(_loaderPath)"
					files: ["\(_loaderPath)", "\(_configPath)"]
					note:  "pronto-analytics' loader: adds Umami's cookieless tracker through the door, unless the browser asks not to be tracked"
				}
				_analyticsOwnHatches: *[] | [...string]
				code: surface: screens: [!~"^(\\(strings.Join(_analyticsOwnHatches, "|")))$"]: hatches: ["analytics"]
				_analyticsUnloaded: [for n, s in code.surface.screens if !list.Contains(s.hatches, "analytics") {n}] & []

				// A business metric is never a journey's and never alerts. The names cannot collide
				// (#BusinessName), and the journeys' alerts are held to read none of them.
				\(H._unalerted)

				code: capabilities: hatches: "analytics-umami": {
					kind: "container"
					note: "a stand-in for Umami on a host launch: the tracker and its collector, counting pageviews"
				}
				code: capabilities: hatches: "analytics-exporter": {
					kind: "container"
					note: "sql_exporter publishing the business metrics from the analytics views, read-only"
				}

				// The door proxies the tracker's two addresses to it on a host launch too.
				code: meta: hostPeers: "umami": 8696
				cluster: surface: targets: umami: {
					srcs: globs: ["analytics/standin.ts"]
					expose: http: {port: 8696, env: "UMAMI_PORT"}
					activate: ""
					"process-compose": activate: "mise x --"
					entrypoint: {
						do:    "UMAMI_SCRIPT=\\(analytics.umami.script) UMAMI_COLLECT=\\(analytics.umami.collect) exec deno run --no-config --allow-net --allow-env analytics/standin.ts"
						shell: "sh"
						dockerfile: {do: "deno run --no-config --allow-net --allow-env /app/analytics/standin.ts", shell: "exec"}
					}
					dockerfile: {
						from: name: "denoland/deno:alpine-2.5.0"
						copy: [{srcs: ["analytics/standin.ts"], dst: "/app/analytics/"}]
					}
					compose: restart: "on-failure"
				}
				cluster: surface: targets: "analytics-exporter": {
					srcs: globs: ["observability/analytics.sql_exporter.yml", "analytics/analytics.nu"]
					expose: metrics: {port: 9399, env: "ANALYTICS_METRICS_PORT"}
					activate: ""
					"process-compose": activate: "mise x --"
					entrypoint: {
						do:    "exec nu -c 'use analytics/analytics.nu; analytics exporter \(H.package)'"
						shell: "sh"
						dockerfile: {do: "sql_exporter -config.file=/etc/sql_exporter/sql_exporter.yml", shell: "exec"}
						after: {migrate: "completed"}
					}
					dockerfile: {
						from: name: "\\(#AnalyticsExporter)"
						copy: [{srcs: ["observability/analytics.sql_exporter.yml"], dst: "/etc/sql_exporter/sql_exporter.yml"}]
					}
					compose: restart: "on-failure"
				}

				"""
		}
	}
}
