// The pronto-alerts host: Cloud Monitoring incidents of an app, delivered to a Pub/Sub topic and read
// from a pull subscription into an inbox on the Mac (README.md). The driver and its rules are this
// host's, written into the app as alerts/; the schema joins the app's package, and the app's own
// alerts_spec.cue (seeded once) holds its project, its phone and its severities. The subscriber's file
// and the lag policy are exported from the spec by bin/pronto-alerts (they hold the app's values).
@extern(embed)

package alerts

import "strings"

_schema: _ @embed(file="schema.cue", type=text)
_driver: _ @embed(file="subscriber.ts", type=text)
_rules:  _ @embed(file="inbox.js", type=text)

#Host: H={
	// The program's CUE package, which the schema joins.
	package!: =~"^[a-z][a-z0-9_]*$"
	// The app's name, and its Google Cloud project: the seed's first values.
	app!:     =~"^[a-z][a-z0-9-]*$"
	project!: =~"^[a-z][a-z0-9-]{4,28}[a-z0-9]$"

	_header: "// generated by pronto-alerts from alerts/host.cue — do not edit\n"

	files: {
		"alerts/subscriber.ts": {seed: false, text: _driver}
		"alerts/inbox.js": {seed: false, text: _rules}
		"alerts_plugin.cue": {
			seed: false
			text: H._header + strings.Replace(_schema, "\npackage alerts\n", "\npackage \(H.package)\n", 1)
		}
		// The app's own: its opt-in. Its generated files (observability/alerts.*.json) follow it each
		// time bin/pronto-alerts runs.
		"alerts_spec.cue": {
			seed: true
			text: """
				package \(H.package)

				// Where this app's Cloud Monitoring incidents are read, and what reaches the phone.
				alerts: {
					app:     "\(H.app)"
					project: "\(H.project)"
					// The severities sent to ntfy; the rest are only in the inbox (~/.cache/pronto/alerts/\(H.app).jsonl).
					push: ["CRITICAL"]
					// ntfy: {url: "https://ntfy.example.com", topic: "\(H.app)-alerts"}  // its token is in the Keychain, never here
				}

				"""
		}
	}
}
