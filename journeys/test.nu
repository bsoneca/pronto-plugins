# The generate step against a fixture app: `./saytw --script tools.nu nu
# journeys/test.nu`. Derives gestures from two screens' markup and patches the
# shell config and the door twice, asserting what each run leaves behind.
use journeys.nu

def check [what: string, ok: bool] {
	if not $ok { error make {msg: $"journeys/test.nu: ($what)"} }
	print $"ok  ($what)"
}

def main [] {
	let dir = mktemp --directory
	cd $dir
	mkdir shell/screens docker
	{routes: [
		{screen: "cart", files: {html: "shell/screens/cart.html"}}
		{screen: "done", files: {html: "shell/screens/done.html"}}
	]} | to json | save shell/shell.json
	'<ul data-live="item" data-on-click="pick" data-on-mutation="tally" data-on-input="typed">
  <li><button data-on-keydown="nudge" data-on-click="pick"></button></li>
</ul>
<form id="coupon" data-entity="coupon" data-action="create"></form>
<form data-entity="order" data-action="create"></form>
<form data-action="navigate" data-route="done"></form>
<form id="" class="x"></form>' | save shell/screens/cart.html
	'<p>{msg.thanks}</p>' | save shell/screens/done.html
	"# generated by pronto\napp: shop\n" | save shell/shell.yaml
	"(app) {\n  # The auth service, unstripped.\n  # Its comment is its own.\n  handle /auth/* {\n    reverse_proxy auth:9999\n  }\n}\n" | save docker/Caddyfile

	journeys derive shop "click,dblclick,change,submit,keydown,drop"
	let derived = open --raw journeys_gestures.cue
	check "derive writes the program's package" ($derived | str contains "\npackage shop\n")
	let gestures = $derived | str substring ($derived | str index-of "_journeyGestures: ")..
		| str replace "_journeyGestures: " "" | from json
	# Handlers for reader events by module, once each (keydown counts; a mutation
	# or input reduce does not); forms by id, else action-entity, else action,
	# else "form" (an empty id is no id).
	check "each screen's gestures" ($gestures.cart == ["coupon" "create-order" "form" "navigate" "nudge" "pick"])
	check "a screen with no gesture has an empty list" ($gestures.done == [])

	journeys route "/t"
	let caddy = open --raw docker/Caddyfile
	let stamp = ls docker/Caddyfile | get modified.0
	check "the collector is a peer the host can rewrite" ($caddy | str contains "{$PRONTO_UPSTREAM_JOURNEYS_COLLECTOR:journeys-collector:8686}")
	check "an apart collector is asked by its own name" ($caddy | str contains "header_up Host {upstream_hostport}")
	journeys route "/t"
	check "a second patch leaves the door untouched" ((ls docker/Caddyfile | get modified.0) == $stamp)
	check "a second patch changes nothing" ((open --raw docker/Caddyfile) == $caddy)
	check "the door caps a batch's size" ($caddy | str contains "    request_body {\n      max_size 64KB\n    }")
	check "the route reaches the collector's own path" (($caddy | str contains "handle /t {") and ($caddy | str contains "    rewrite * /telemetry"))
	check "the route lands above the auth route's comment" (($caddy | str index-of "pronto-journeys:end") < ($caddy | str index-of "# The auth service"))

	journeys route "/v2/t"
	let moved = open --raw docker/Caddyfile
	check "a changed endpoint replaces the route" (($moved | str contains "handle /v2/t {") and not ($moved | str contains "handle /t {"))

	"(app) {\n}\n" | save --force docker/Caddyfile
	check "a door with no auth route refuses" (try { journeys route "/t"; false } catch { true })

	cd -
	rm --recursive $dir
}
