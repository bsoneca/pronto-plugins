#!/bin/sh
# Writes the node release engine (node/engine/, node/README.md) into apps whose release.cue holds
# Node: node.#Release, each file regenerated:
#   bin/pronto-node --engine [--release-rule] <app-dir>...
# --release-rule also merges the release@k8s rule into each app's .say.json (an app that has it keeps it without the flag).
# Or the node host files (node/host/, node/README.md, "The node host") into the folder that holds a node's values:
#   bin/pronto-node --host <dir>...
# which writes <dir>/node-host/{docker-gc.sh,dapr-heal.sh,host.nu,kubelet.nu,schema/host.cue}, each regenerated.
set -eu
here=$(cd "$(dirname "$0")/.." && pwd)
usage="usage: pronto-node --engine [--release-rule] <app-dir>... | --host <dir>..."
case "${1:-}" in --engine | --host) mode=$1 ;; *) echo "$usage" >&2; exit 2 ;; esac
shift
tag=
if [ "$mode" = --engine ] && [ "${1:-}" = --release-rule ]; then tag="-t releaseRule=true"; shift; fi
[ $# -ge 1 ] || { echo "$usage" >&2; exit 2; }
case "$1" in -*) echo "$usage" >&2; exit 2 ;; esac
files=$(mktemp)
trap 'rm -f "$files"' EXIT
if [ "$mode" = --engine ]; then export_pkg=./node/engine/export; else export_pkg=./node/host/export; fi
# shellcheck disable=SC2086
(cd "$here" && ./saytw --script tools.nu cue export $tag $export_pkg -e files --out json) > "$files"
for dir in "$@"; do
	app=$(cd "$dir" && pwd)
	if [ "$mode" = --engine ]; then
		[ -f "$app/release.cue" ] || { echo "pronto-node: $app has no release.cue" >&2; exit 2; }
	fi
	(cd "$here" && ./saytw --script tools.nu nu bin/write.nu "$files" "$app")
done
