#!/bin/sh
# Adds or refreshes the analytics host in a pronto app:
#   bin/pronto-analytics <app-dir> [journeys=false] [modular=true]
# journeys=false: the app has no journeys plugin, so there are no alerts to hold clear of the
# business metrics.
# modular=true: the app is modular (pronto-modular-design): the schema goes into modules/schema, the spec is
# modules/analytics's, and the program's package embeds the module's export (join/analytics.json).
set -eu
here=$(cd "$(dirname "$0")/.." && pwd)
# Or Grafana and Umami on a cluster the operator runs (pronto's envs.Metal), as analytics/metal.nu says:
#   bin/pronto-analytics metal --ssh U@H --project P --grafana-domain G --umami-domain U --users-file F --dashboards app/name=path,…
if [ "${1:-}" = metal ]; then
	shift
	cd "$here"
	exec ./saytw --script tools.nu nu analytics/metal.nu "$@"
fi
app=$(cd "$1" && pwd)
shift
package=$(sed -n 's/^package[[:space:]]\{1,\}\([a-z][a-z0-9_]*\)[[:space:]]*$/\1/p' "$app/program.cue" | head -n 1)
[ -n "$package" ] || { echo "pronto-analytics: $app/program.cue names no package" >&2; exit 2; }
tags=""
for kv in "$@"; do
	case "$kv" in
	journeys=true | journeys=false) tags="$tags -t $kv" ;;
	modular=false) ;;
	modular=true)
		module=$(sed -n 's/^module:[[:space:]]*"\([^"@]*\).*$/\1/p' "$app/cue.mod/module.cue" | head -n 1)
		[ -n "$module" ] || { echo "pronto-analytics: $app/cue.mod/module.cue names no module" >&2; exit 2; }
		tags="$tags -t module=$module" ;;
	*) echo "pronto-analytics: unknown argument $kv" >&2; exit 2 ;;
	esac
done
files=$(mktemp)
trap 'rm -f "$files"' EXIT
cd "$here"
# shellcheck disable=SC2086
./saytw --script tools.nu cue export ./analytics/export -t "package=$package" $tags -e files --out json > "$files"
./saytw --script tools.nu nu bin/write.nu "$files" "$app"
