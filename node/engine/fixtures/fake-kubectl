#!/usr/bin/env python3
# A kubectl for the node engine's tests: logs every call (and the objects it was given on stdin) to
# $FAKE_DIR/calls.jsonl and answers from state files in $FAKE_DIR, as a cluster would for the calls a
# release makes. Nothing here reaches a cluster.
#
# State (all optional): namespaces/<ns> (exists), revision/<deployment> (an int; apply of a Deployment
# bumps it), reject (a Kind that a server dry run refuses), job_fail, rollout_fail (a name),
# bare (pods without daprd), cluster_instances_ready (how many of the database's instances are ready, a number: all of the Cluster's by default), operators.json (image tags by deployment), noprimary, buildkit_down and
# registry_down (the node's builder or registry has no available replica), get_fail_<kind> and missing_<kind>
# (a read of <kind> in every namespace is refused, or its CRD is not on the node), read_fail_namespace and
# read_fail_cluster (any read of a namespace, or of the database Cluster, fails as an API error) and
# read_fail_deployment (a Deployment's name whose read fails), patch_fail (a patch of the database Cluster is refused), inuse (an image the pods name), cm_race_once (the same, once), cm_race (the record is rewritten between a read and a patch), strict_cm (a patch of a missing record is NotFound), lease_delete_fail (deleting a release's Lease is refused), lock_delete_fail (deleting the lock by precondition is refused), lock_taken_over (a lock's resourceVersion moves between a read and a delete), no_repositories (the registry has none yet), find_fail (the registry's upload scan fails), lease_patch_fail_from (the Nth patch of a Lease and every one after fails), lease_patch_fail_once (only the Nth patch of a Lease fails), lease_patch_notfound_from (the Lease is gone from the Nth patch on: NotFound), lease_patch_fail (a patch of a Lease fails), db_fail (psql and pg_dump in a database pod fail), db_tables/<ns> (how many tables that namespace's database has: none by default), no_cluster/<ns> (no database Cluster there), schema_from/<ns> (the namespace the schema was copied from: what an annotate of pronto.dev/schema-from leaves), lease_conflict (a replace of a Lease finds it modified). `--ignore-not-found` answers an absent
# object with nothing and exit 0, as kubectl does.
import json, os, sys

d = os.environ["FAKE_DIR"]
args = sys.argv[1:]
stdin = sys.stdin.read() if (("-f" in args and "-" in args) or (args[:1] == ["exec"] and "-i" in args)) else ""
os.makedirs(d + "/namespaces", exist_ok=True)
os.makedirs(d + "/revision", exist_ok=True)

def items(text):
    text = text.strip()
    if not text:
        return []
    if text.startswith("{"):
        doc = json.loads(text)
        return doc["items"] if doc.get("kind") == "List" else [doc]
    # a YAML stream (upstream's): kind/name/namespace of each document by their first lines
    import re
    out = []
    for doc in re.split(r"(?m)^---\s*$", text):
        if not doc.strip():
            continue
        kind = re.search(r"(?m)^kind:\s*(\S+)", doc)
        name = re.search(r"(?m)^  name:\s*(\S+)", doc)
        ns = re.search(r"(?m)^  namespace:\s*(\S+)", doc)
        out.append({"kind": kind.group(1) if kind else "", "metadata": {"name": name.group(1) if name else "", "namespace": ns.group(1) if ns else None}, "_yaml": True, "_raw": doc})
    return out

objs = items(stdin) if "-f" in args and "-" in args and args[:1] != ["exec"] else []
with open(d + "/calls.jsonl", "a") as f:
    f.write(json.dumps({"as": os.path.basename(os.environ.get("KUBECONFIG", "")), "args": args, "objects": [{"kind": o.get("kind"), "name": o.get("metadata", {}).get("name"), "namespace": o.get("metadata", {}).get("namespace")} for o in objs]}) + "\n")
    if objs:
        with open(d + "/last_objects.json", "w") as g:
            json.dump(objs, g)
        with open(d + "/all_objects.jsonl", "a") as g:
            g.write(json.dumps(objs) + "\n")

def out(x):
    print(json.dumps(x))
    sys.exit(0)

def fail(msg):
    print(msg, file=sys.stderr)
    sys.exit(1)

def opt(flag):
    return args[args.index(flag) + 1] if flag in args else None

def exists(path):
    return os.path.exists(d + "/" + path)

def read(path, default=""):
    try:
        return open(d + "/" + path).read().strip()
    except FileNotFoundError:
        return default

verb = args[0] if args else ""
ns = opt("-n")

# `auth can-i`: yes, but for what auth_deny names (a line of it that the question holds), and `create namespaces`, which only an
# operator may (auth_operator makes the KUBECONFIG one).
if verb == "auth" and args[1:2] == ["can-i"]:
    q = " ".join(args[2:])
    deny = [l for l in read("auth_deny").split("\n") if l] if exists("auth_deny") else []
    if q.strip() == "create namespaces":
        ans = exists("auth_operator")
    else:
        ans = not any(l in q for l in deny)
    print("yes" if ans else "no")
    sys.exit(0 if ans else 1)

if verb == "config":
    print("apiVersion: v1\nkind: Config\ncurrent-context: contabo2\nclusters:\n- name: contabo2\n  cluster:\n    server: https://127.0.0.1:26444\n    certificate-authority-data: Zg==\ncontexts:\n- name: contabo2\n  context: {cluster: contabo2, user: u}\nusers:\n- name: u\n  user: {token: t}\n")
    sys.exit(0)

# coordination.k8s.io Leases, as the API server answers them: creationTimestamp, uid and resourceVersion are the server's,
# a create of an existing name is AlreadyExists, a replace against a stale resourceVersion is a Conflict.
import datetime
def lease_path(name):
    return d + "/lease/" + name
def server_stamp(o):
    n = int(read("lease_rv", "100")) + 1
    open(d + "/lease_rv", "w").write(str(n))
    o["metadata"]["resourceVersion"] = str(n)
    o["metadata"]["uid"] = f"00000000-0000-0000-0000-{n:012d}"

if verb in ("create", "replace") and any(o.get("kind") == "Lease" for o in objs):
    os.makedirs(d + "/lease", exist_ok=True)
    for o in objs:
        name = o["metadata"]["name"]
        if verb == "create":
            if os.path.exists(lease_path(name)):
                fail(f'Error from server (AlreadyExists): leases.coordination.k8s.io "{name}" already exists')
            o["metadata"]["creationTimestamp"] = datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
        else:
            if exists("lease_conflict"):
                fail(f'Error from server (Conflict): Operation cannot be fulfilled on leases.coordination.k8s.io "{name}": the object has been modified; please apply your changes to the latest version and try again')
            if not os.path.exists(lease_path(name)):
                fail(f'Error from server (NotFound): leases.coordination.k8s.io "{name}" not found')
            cur = json.load(open(lease_path(name)))
            if o["metadata"].get("resourceVersion") != cur["metadata"]["resourceVersion"]:
                fail(f'Error from server (Conflict): Operation cannot be fulfilled on leases.coordination.k8s.io "{name}": the object has been modified; please apply your changes to the latest version and try again')
            o["metadata"]["creationTimestamp"] = cur["metadata"]["creationTimestamp"]
        server_stamp(o)
        json.dump(o, open(lease_path(name), "w"))
        print(f"lease.coordination.k8s.io/{name} {'created' if verb == 'create' else 'replaced'}")
    sys.exit(0)

if verb == "patch" and len(args) > 1 and args[1] == "lease":
    if exists("lease_patch_fail"):
        fail("Error from server (ServiceUnavailable): the server is currently unable to handle the request")
    if exists("lease_patch_fail_from") or exists("lease_patch_fail_once") or exists("lease_patch_notfound_from"):
        n = int(read("lease_patch_count", "0")) + 1
        open(d + "/lease_patch_count", "w").write(str(n))
        if exists("lease_patch_fail_from") and n >= int(read("lease_patch_fail_from")):
            fail("Error from server (ServiceUnavailable): the server is currently unable to handle the request")
        if exists("lease_patch_fail_once") and n == int(read("lease_patch_fail_once")):
            fail("Error from server (ServiceUnavailable): the server is currently unable to handle the request")
        if exists("lease_patch_notfound_from") and n >= int(read("lease_patch_notfound_from")) and os.path.exists(lease_path(args[2])):
            os.remove(lease_path(args[2]))
    p = lease_path(args[2])
    if not os.path.exists(p):
        fail(f'Error from server (NotFound): leases.coordination.k8s.io "{args[2]}" not found')
    o = json.load(open(p))
    o["spec"].update(json.loads(opt("-p"))["spec"])
    server_stamp(o)
    json.dump(o, open(p, "w"))
    print(f"lease.coordination.k8s.io/{args[2]} patched")
    sys.exit(0)

if verb == "delete" and "--raw" in args:
    # a delete with preconditions (uid, resourceVersion), as the API server checks them
    uri = args[args.index("--raw") + 1] if args[-1] != "--raw" else ""
    name = [a for a in args if a.startswith("/apis/coordination.k8s.io/v1/namespaces/")][0].rsplit("/", 1)[1]
    if not os.path.exists(lease_path(name)):
        fail(f'Error from server (NotFound): leases.coordination.k8s.io "{name}" not found')
    if exists("lock_delete_fail"):
        fail("Error from server (Forbidden): leases.coordination.k8s.io is forbidden")
    cur = json.load(open(lease_path(name)))
    pre = objs[0].get("preconditions", {}) if objs else {}
    if exists("lock_taken_over"):
        cur["metadata"]["resourceVersion"] = "999"
    if pre.get("uid") != cur["metadata"].get("uid") or pre.get("resourceVersion") != cur["metadata"].get("resourceVersion"):
        fail(f'Error from server (Conflict): Precondition failed: UID in precondition or ResourceVersion in precondition does not match')
    os.remove(lease_path(name))
    print("{\"kind\":\"Status\",\"status\":\"Success\"}")
    sys.exit(0)

if verb == "delete" and len(args) > 1 and args[1] == "lease":
    if exists("lease_delete_fail"):
        fail("Error from server (Forbidden): leases.coordination.k8s.io is forbidden")
    if os.path.exists(lease_path(args[2])):
        os.remove(lease_path(args[2]))
        print(f'lease.coordination.k8s.io "{args[2]}" deleted')
    sys.exit(0)

if verb == "create":
    # a server dry run of a create: refused when the object exists (an earlier release's Job of the same name)
    for o in objs:
        if o.get("kind") == "Job" and o["metadata"]["name"] in read("existing_jobs").split():
            fail(f'Error from server (AlreadyExists): jobs.batch "{o["metadata"]["name"]}" already exists')
    for o in objs:
        print(f'{o.get("kind", "").lower()}/{o["metadata"]["name"]} created (server dry run)')
    sys.exit(0)

if verb == "patch":
    if exists("patch_fail") and len(args) > 1 and args[1].startswith("cluster.postgresql"):
        fail("Error from server (Forbidden): patch is forbidden")
    if len(args) > 2 and args[1] == "configmap" and args[2] == "pronto-release":
        p = d + "/cm/pronto-release"
        if exists("strict_cm") and not os.path.exists(p):
            fail('Error from server (NotFound): configmaps "pronto-release" not found')
        o = json.load(open(p)) if os.path.exists(p) else {"metadata": {"name": "pronto-release", "labels": {}, "annotations": {}}, "data": {}}
        body = json.loads(opt("-p"))
        want = body.get("metadata", {}).get("resourceVersion")
        if exists("cm_race") and want is not None:
            server_stamp(o)  # another release wrote the record after it was read
        if exists("cm_race_once") and want is not None:
            server_stamp(o)
            os.remove(d + "/cm_race_once")
        if want is not None and want != o["metadata"].get("resourceVersion"):
            fail('Error from server (Conflict): Operation cannot be fulfilled on configmaps "pronto-release": the object has been modified; please apply your changes to the latest version and try again')
        o["data"].update(body["data"])
        server_stamp(o)
        os.makedirs(d + "/cm", exist_ok=True)
        json.dump(o, open(p, "w"))
        sys.exit(0)
    sys.exit(0)

if verb == "apply":
    dry = any(a.startswith("--dry-run") for a in args)
    for o in objs:
        # a Job an earlier release left holds its pod template immutably: applying a new one in place is refused
        if dry and o.get("kind") == "Job" and o["metadata"]["name"] in read("existing_jobs").split():
            fail(f'The Job "{o["metadata"]["name"]}" is invalid: spec.template: Invalid value: field is immutable')
        if dry and o.get("kind") == read("reject"):
            fail(f'Error from server: admission webhook denied the request: {o.get("kind")}/{o["metadata"]["name"]}')
    if not dry:
        for o in objs:
            kind, name = o.get("kind"), o["metadata"]["name"]
            if kind == "Namespace":
                open(d + "/namespaces/" + name, "w").write(json.dumps(o.get("metadata", {}).get("labels", {})))
            if kind == "Deployment" and name not in read("unchanged").split():
                p = d + "/revision/" + name
                rev = int(open(p).read()) if os.path.exists(p) else 0
                # `revision_lag` names a Deployment whose template the server accepts (generation moves) while its
                # revision annotation has not caught up
                if read("revision_lag") != name:
                    open(p, "w").write(str(rev + 1))
                os.makedirs(d + "/generation", exist_ok=True)
                g = d + "/generation/" + name
                gen = int(open(g).read()) if os.path.exists(g) else 1
                open(g, "w").write(str(gen + 1))
            if kind == "ConfigMap" and name == "pronto-release":
                os.makedirs(d + "/cm", exist_ok=True)
                cmo = {"metadata": {"name": name, "labels": {}, "annotations": {}}, "data": o.get("data", {})}
                server_stamp(cmo)
                json.dump(cmo, open(d + "/cm/" + name, "w"))
            if kind == "Cluster" and not o.get("_yaml"):
                open(d + "/cluster_image", "w").write(o["spec"]["imageName"])
                open(d + "/cluster_instances", "w").write(str(o["spec"].get("instances", 1)))
            if kind == "Cluster" and o.get("_yaml"):
                m = __import__("re").search(r"(?m)^  imageName:\s*(\S+)", o["_raw"])
                if m:
                    open(d + "/cluster_image", "w").write(m.group(1))
    for o in objs:
        print(f'{o.get("kind", "").lower()}/{o["metadata"]["name"]} configured')
    sys.exit(0)

if verb == "port-forward":
    # the door check's forward: its pid is recorded and removed when it is stopped, so a leftover pid file is a leak
    if exists("port_forward_fail"):
        fail("error: unable to forward port because pod is not running")
    import signal, time
    open(d + "/portforward.pid", "w").write(str(os.getpid()))
    open(d + "/portforward.args", "w").write(" ".join(args))
    def stop(*_):
        try:
            os.remove(d + "/portforward.pid")
        except FileNotFoundError:
            pass
        sys.exit(0)
    signal.signal(signal.SIGTERM, stop)
    time.sleep(60)
    stop()

if verb == "get":
    what = args[1]
    if what == "service" and ns == "envoy-gateway-system":
        # the Envoy Gateway data-plane Service of a Gateway, found by its owning labels
        sel = opt("-l") or ""
        # on the node one Service of the GatewayClass serves every merged Gateway (`shared_gateway`)
        if exists("no_gateway_service"):
            out({"items": []})
        if "owning-gatewayclass=" in sel:
            out({"items": [{"metadata": {"name": "pronto-gateway"}, "spec": {"clusterIP": "10.43.0.9", "ports": [{"port": 80}]}}] if exists("shared_gateway") else []})
        if exists("shared_gateway") or "owning-gateway-name=" not in sel or "owning-gateway-namespace=" not in sel:
            out({"items": []})
        out({"items": [{"metadata": {"name": "envoy-" + sel.split("owning-gateway-name=")[1].split(",")[0]}, "spec": {"clusterIP": "10.43.0.9", "ports": [{"port": 80}]}}]})
    if "-A" in args:
        # the prune's reads of every namespace's workloads
        if what == "pods" and exists("inuse"):
            out({"items": [{"spec": {"containers": [{"image": read("inuse")}]}}]})
        if exists("get_fail_" + what):
            fail("Error from server (Forbidden): " + what + " is forbidden")
        if exists("missing_" + what):
            fail('error: the server doesn\'t have a resource type "' + what + '"')
        out({"items": []})
    if what == "crd":
        if "json" in args:
            out({"metadata": {"annotations": {"gateway.networking.k8s.io/bundle-version": read("gateway_api", "v1.2.1")}}})
        sys.exit(0)
    if what == "nodes":
        out({"items": [{"status": {"images": [{"names": ["127.0.0.1:5000/x@sha256:aa"]}]}}]})
    if what == "namespace":
        if exists("read_fail_namespace"):
            fail("Unable to connect to the server: net/http: TLS handshake timeout")
        if exists("namespaces/" + args[2]):
            if "json" in args:
                out({"metadata": {"labels": json.loads(read("namespaces/" + args[2], "{}") or "{}")}})
            sys.exit(0)
        if "--ignore-not-found" in args:
            sys.exit(0)
        fail(f'Error from server (NotFound): namespaces "{args[2]}" not found')
    if what == "lease" or what == "leases":
        if exists("read_fail_cluster"):
            fail("Unable to connect to the server: net/http: TLS handshake timeout")
        os.makedirs(d + "/lease", exist_ok=True)
        if what == "leases":
            sel = (opt("-l") or "").split("=")[0]
            items = [json.load(open(lease_path(n))) for n in sorted(os.listdir(d + "/lease"))]
            if sel:
                items = [i for i in items if sel in i["metadata"].get("labels", {})]
            out({"apiVersion": "v1", "kind": "List", "items": items, "metadata": {"resourceVersion": ""}})
        if os.path.exists(lease_path(args[2])):
            out(json.load(open(lease_path(args[2]))))
        if "--ignore-not-found" in args:
            sys.exit(0)
        fail(f'Error from server (NotFound): leases.coordination.k8s.io "{args[2]}" not found')
    if what == "configmap" or what == "configmaps":
        if exists("read_fail_cluster"):
            fail("Unable to connect to the server: net/http: TLS handshake timeout")
        os.makedirs(d + "/cm", exist_ok=True)
        p = d + "/cm/" + args[2]
        if os.path.exists(p):
            out(json.load(open(p)))
        if exists("serving_sha") and args[2] == "pronto-release":
            out({"metadata": {"name": args[2]}, "data": {"sha": read("serving_sha")}})
        if "--ignore-not-found" in args:
            sys.exit(0)
        fail(f'Error from server (NotFound): configmaps "{args[2]}" not found')
    if what == "gatewayclass":
        out({"status": {"conditions": [{"type": "Accepted", "status": "True"}]}})
    if what == "deployment":
        name = args[2]
        ops = {
            "dapr-operator": "docker.io/daprio/operator:1.16.21",
            "cnpg-controller-manager": "ghcr.io/cloudnative-pg/cloudnative-pg:1.30.1",
            "external-secrets": "ghcr.io/external-secrets/external-secrets:v0.10.5",
            "envoy-gateway": "docker.io/envoyproxy/gateway:v1.2.4",
            "barman-cloud": "ghcr.io/cloudnative-pg/plugin-barman-cloud:v0.15.1"}
        ops.update(json.loads(read("operators.json", "{}")))
        if name in ("buildkitd", "registry"):
            down = exists("buildkit_down") if name == "buildkitd" else exists("registry_down")
            env = json.loads(read("registry_env", "[]")) if name == "registry" else []
            out({"status": {"availableReplicas": 0 if down else 1}, "spec": {"template": {"spec": {"containers": [{"env": env}]}}}})
        if name in ops:
            out({"spec": {"template": {"spec": {"containers": [{"image": ops[name]}]}}}})
        if read("read_fail_deployment") == name:
            fail("Unable to connect to the server: net/http: TLS handshake timeout")
        if exists("revision/" + name):
            out({"metadata": {"generation": int(read("generation/" + name, "1")), "annotations": {"deployment.kubernetes.io/revision": read("revision/" + name)}}})
        if "--ignore-not-found" in args:
            sys.exit(0)
        fail(f'Error from server (NotFound): deployments.apps "{name}" not found')
    if what == "secret":
        name = args[2]
        if name.endswith("-auth-secrets"):
            import base64
            out({"data": {"PGRST_JWT_SECRET": base64.b64encode(b"s3cret-s3cret-s3cret-s3cret-s3cret").decode()}})
        if exists("secrets/" + name):
            out({"metadata": {"name": name}})
        fail(f'Error from server (NotFound): secrets "{name}" not found')
    if what == "pods":
        sel = opt("-l") or ""
        if "cnpg.io/podRole=instance" in sel:
            image = read("cluster_image", "none")
            n = int(read("cluster_instances_ready", read("cluster_instances", "1")))
            out({"items": [{"metadata": {"name": "db-%d" % i}, "spec": {"containers": [{"name": "postgres", "image": image}]}, "status": {"conditions": [{"type": "Ready", "status": "True"}]}} for i in range(1, n + 1)]})
        if "cnpg.io/instanceRole=primary" in sel:
            if exists("noprimary"):
                out({"items": []})
            image = read("cluster_image", "none")
            out({"items": [{"metadata": {"name": "db-1"}, "spec": {"containers": [{"name": "postgres", "image": image}]}, "status": {"conditions": [{"type": "Ready", "status": "True"}]}}]})
        # what a release's cleanup waits to be gone (the airlock's, a bridge's): none
        if "pronto.dev/probe!=wall" in sel:
            out({"items": []})
        # the daprd check
        cs = [{"name": "app"}] + ([] if exists("bare") else [{"name": "daprd"}])
        out({"items": [{"metadata": {"name": "p1"}, "spec": {"containers": cs}}]})
    if what == "job":
        name = args[2]
        out({"status": {"failed": 1} if exists("job_fail") else {"succeeded": 1}})
    if what.startswith("clusters.postgresql.cnpg.io"):
        # the Clusters already in the namespace (`live_clusters`, names one a line): what a tenant's preflight lists
        if not exists("live_clusters"):
            sys.exit(0)
        out({"items": [{"metadata": {"name": n}} for n in read("live_clusters").split()]})
    if what.startswith("cluster.postgresql.cnpg.io"):
        if exists("read_fail_cluster"):
            fail("Unable to connect to the server: net/http: TLS handshake timeout")
        # the database Cluster: its image when one was recorded, its primary and database, and the namespace it was copied into
        # (`schema_from/<ns>`, written by an annotate of pronto.dev/schema-from)
        cluster = {"metadata": {"annotations": ({"pronto.dev/schema-from": read("schema_from/" + (ns or ""))} if exists("schema_from/" + (ns or "")) else {})}, "spec": {"bootstrap": {"initdb": {"database": "app"}}}, "status": {"currentPrimary": "db-1", "managedRolesStatus": {"byStatus": {"reconciled": ["authenticator"], "pending-reconciliation": []}}}}
        if exists("previous_image"):
            cluster["spec"]["imageName"] = read("previous_image")
        if exists("no_cluster/" + (ns or "")):
            if "--ignore-not-found" in args:
                sys.exit(0)
            fail("Error from server (NotFound): clusters.postgresql.cnpg.io not found")
        out(cluster)
    if what == "externalsecret":
        sys.exit(0)
    sys.exit(0)

if verb == "annotate":
    for a in args:
        if a.startswith("pronto.dev/schema-from="):
            os.makedirs(d + "/schema_from", exist_ok=True)
            open(d + "/schema_from/" + (ns or ""), "w").write(a.split("=", 1)[1])
    sys.exit(0)

if verb == "rollout":
    if args[1] == "undo":
        if read("undo_fail") == args[2].split("/")[-1]:
            fail("error: no rollout history found")
        # the Deployment is back on its earlier revision: its rollout no longer fails
        if read("rollout_fail") == args[2].split("/")[-1]:
            os.remove(d + "/rollout_fail")
    if args[1] == "restart":
        open(d + "/registry_restarted", "w").close()
    if args[1] == "status":
        target = args[2]
        if exists("rollout_fail") and read("rollout_fail") == target.split("/")[-1]:
            fail(f"error: deployment \"{target.split('/')[-1]}\" exceeded its progress deadline")
    sys.exit(0)

if verb == "exec":
    cmd = " ".join(args[args.index("--") + 1:]) if "--" in args else ""
    # psql and pg_dump in a database pod: logged with the namespace they ran in and the SQL they were given
    ro = "env PGOPTIONS=-c default_transaction_read_only=on "
    read_only = cmd.startswith(ro)
    cmd = cmd[len(ro):] if read_only else cmd
    if cmd.startswith("psql ") or cmd.startswith("pg_dump "):
        with open(d + "/db.log", "a") as g:
            g.write(json.dumps({"ns": ns, "cmd": cmd, "stdin": stdin, "read_only": read_only}) + "\n")
        if exists("db_fail"):
            fail("psql: error: connection to server failed")
        if cmd.startswith("pg_dump "):
            print("-- pgroll rows\nCOPY pgroll.migrations FROM stdin;" if "--data-only" in cmd else "CREATE TABLE public.game ();")
        elif "current_setting('pronto.schema_from'" in stdin:
            print(read("db_marked/" + (ns or ""), ""))
        elif "pgroll.migrations m" in stdin:
            print(read("pgroll_mark_after", "2 abc") if exists("pgroll_mark_seen") else "2 abc")
            open(d + "/pgroll_mark_seen", "w").write("1")
        elif "information_schema.tables" in stdin:
            print(read("db_tables/" + (ns or ""), "0"))
        elif "pg_namespace" in stdin:
            print("1")
        elif "CREATE ROLE" in stdin or "pg_roles" in stdin:
            print("DO $x$ BEGIN CREATE ROLE analytics_reader NOLOGIN; EXCEPTION WHEN duplicate_object THEN NULL; END $x$;")
        sys.exit(0)
    if "find " in cmd and "-maxdepth 0" in cmd and exists("no_repositories"):
        fail("find: '/var/lib/registry/docker/registry/v2/repositories': No such file or directory")
    if "find " in cmd and exists("find_fail"):
        fail("find: '/var/lib/registry/docker/registry/v2/repositories': Permission denied")
    if "find " in cmd:
        print(read("uploads"))
    elif "du -sh" in cmd:
        print("1M\t/var/lib/registry")
    elif "garbage-collect" in cmd:
        print("12 blobs marked, 3 blobs eligible for deletion")
    elif cmd.startswith("cat "):
        print(read("registry_config", "storage:\n  cache:\n    blobdescriptor: inmemory\n"))
    sys.exit(0)

if verb == "logs":
    print("fake log")
    sys.exit(0)

sys.exit(0)
