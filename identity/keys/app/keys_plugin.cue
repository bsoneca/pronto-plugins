// generated by pronto-keys from identity/keys/app/ — do not edit
package __PACKAGE__

// The keys service (pronto-keys; identity/keys/README.md): an account's API keys (`/auth/keys*`, `/auth/key`) and the
// door's account check (`/auth/door`) for an app on a mecha whose auth service has neither. It signs with the stack's
// secret and reads mecha_auth.api_key in place. The door's Caddyfile routes to it (pronto/keys.cue's generate step), and
// flags_plugin.cue's /ofrep/ asks its /auth/door where this file is installed.

// The function that gates keys per account, `schema.name(owner uuid) returns boolean` (AUTH_API_KEYS_GATE); empty, no gate.
keysGate: *"" | string
// The function called on every exchange, `schema.name(owner uuid) returns void` (AUTH_KEY_EXCHANGED_HOOK); empty, none.
keysHook: *"" | string
// The database a launch at hand is made in (POSTGRES_DB's default): the app's name as the stack gives it.
keysDb: *"__PACKAGE__" | string

code: capabilities: hatches: keys: {
	kind: "container"
	note: "pronto-keys' service: an account's API keys and the door's account check, over mecha_auth.api_key"
}

// The door proxies to it by its peer address: where a launch hands the service its port, the door's variable follows.
cluster: surface: targets: caddy: entrypoint: env: PRONTO_UPSTREAM_KEYS: {peer: "keys", port: "http"}

cluster: surface: targets: keys: {
	srcs: globs: ["keys/*.ts", "keys/vendor/*.js"]
	expose: http: {port: 8702, env: "KEYS_PORT"}
	"process-compose": activate: "mise x --"
	entrypoint: {
		do:    "exec deno run --no-config --allow-net --allow-env keys/main.ts"
		shell: "sh"
		dockerfile: {do: "exec deno run --no-config --allow-net --allow-env /app/keys/main.ts", shell: "sh"}
		env: compose.environment & {
			// The database owner's, as the auth service's: 0.32's auth revokes every other role's grants on mecha_auth.
			DATABASE_URL: ["postgres://${POSTGRES_USER:-postgres}:${POSTGRES_PASSWORD:-postgres}@", {peer: "database", port: "pg"}, "/${POSTGRES_DB:-\(keysDb)}"]
		}
		after: {migrate: "completed"}
	}
	dockerfile: {
		from: name: "denoland/deno:alpine-2.5.0"
		copy: [
			{srcs: ["keys/keys.ts", "keys/main.ts"], dst: "/app/keys/"},
			{srcs: ["keys/vendor/postgres.js"], dst: "/app/keys/vendor/"},
		]
	}
	compose: {
		restart: "on-failure"
		environment: {
			// The stack's secret, the auth service's own (a release overrides it with the project's).
			PGRST_JWT_SECRET: "${PGRST_JWT_SECRET:-mecha-dev-secret-please-override-32ch}"
			AUTH_API_KEYS:    "true"
			// The auth service's statement bound, in ms (identity/keys/README.md).
			AUTH_STATEMENT_TIMEOUT_MS: "5000"
			if keysGate != "" {AUTH_API_KEYS_GATE: keysGate}
			if keysHook != "" {AUTH_KEY_EXCHANGED_HOOK: keysHook}
		}
	}
}
