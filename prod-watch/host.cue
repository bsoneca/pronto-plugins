// The prod-watch host: what an app's Cloud Run services logged that may be a bug, read by an
// agent on a loop (README.md). The driver and its rules are this host's, written into the app as
// prod-watch/; the schema joins the app's package, and the app's own prod_watch.cue (seeded once)
// holds the services it answers for besides its release's and its own noise.
@extern(embed)

package prodwatch

import "strings"

_schema: _ @embed(file="schema.cue", type=text)
_driver: _ @embed(file="prod-watch.ts", type=text)
_rules:  _ @embed(file="watch.js", type=text)

#Host: H={
	// The program's CUE package, which the schema joins.
	package!: =~"^[a-z][a-z0-9_]*$"

	_header: "// generated by pronto-prod-watch from prod-watch/host.cue — do not edit\n"

	files: {
		"prod-watch/prod-watch.ts": {seed: false, text: _driver}
		"prod-watch/watch.js": {seed: false, text: _rules}
		"prod_watch_plugin.cue": {
			seed: false
			text: H._header + strings.Replace(_schema, "\npackage prodwatch\n", "\npackage \(H.package)\n", 1)
		}
		// The app's own: its opt-in. Not prod-watch.cue: sayt's lint vets an X.cue against a path X,
		// and prod-watch/ is this host's.
		"prod_watch.cue": {
			seed: true
			text: """
				package \(H.package)

				// What prod-watch watches of this app besides its release's service and its apart sidecars:
				// other Cloud Run services of the project it answers for, and its own noise rules (the
				// shared ones come with the schema).
				prodWatch: {
					services: []
					noise: {}
				}

				"""
		}
	}
}
