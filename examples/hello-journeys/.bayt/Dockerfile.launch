FROM busybox:musl@sha256:03db190ed4c1ceb1c55d179a0940e2d71d42130636a780272629735893292223 AS launch
WORKDIR /monorepo/.
COPY .bayt/Taskfile.yml .bayt/Taskfile.bayt.yml .bayt/bayt.launch.json ./.bayt/
CMD ["tail", "-f", "/dev/null"]

FROM busybox:musl@sha256:03db190ed4c1ceb1c55d179a0940e2d71d42130636a780272629735893292223 AS launch_bayt_ctxs
WORKDIR /monorepo/.
COPY --parents .bayt/compose.launch.yaml .bayt/Dockerfile.launch .bayt/bayt.launch.json .bayt/Taskfile.yml .bayt/Taskfile.bayt.yml .bayt/compose.launch.closure.yaml .bayt/process-compose.yaml .bayt/compose.*.yaml .bayt/Dockerfile.* .bayt/bayt.*.json .bayt/Taskfile.*.yaml mecha/${MONOREPO_COMPOSE_MODE:-docker-image}.yaml omnishell/${MONOREPO_COMPOSE_MODE:-docker-image}.yaml ./
COPY --from=hello-journeys-caddy_bayt /monorepo /monorepo
ARG SOURCE_DATE_EPOCH
ARG BAYT_CLAMP=1
RUN if [ "${BAYT_CLAMP:-1}" != 0 ]; then find /monorepo/. -exec touch -hd @${SOURCE_DATE_EPOCH:-0} {} + && touch -hd @${SOURCE_DATE_EPOCH:-0} /monorepo; fi
FROM scratch AS launch_bayt
COPY --from=launch_bayt_ctxs /monorepo /monorepo
