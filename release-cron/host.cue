// The release-cron host: an app released to production on a schedule, by launchd on the operator's
// Mac, from main (README.md). The driver and its rules are this host's, written into the app as
// release-cron/; the schema joins the app's package, and the app's own release_cron.cue (seeded
// once) holds what it releases and what production must answer.
@extern(embed)

package releasecron

import "strings"

_schema: _ @embed(file="schema.cue", type=text)
_driver: _ @embed(file="release-cron.ts", type=text)
_rules:  _ @embed(file="cron.js", type=text)

#Host: H={
	// The program's CUE package, which the schema joins.
	package!: =~"^[a-z][a-z0-9_]*$"

	_header: "// generated by pronto-release-cron from release-cron/host.cue — do not edit\n"

	files: {
		"release-cron/release-cron.ts": {seed: false, text: _driver}
		"release-cron/cron.js": {seed: false, text: _rules}
		"release_cron_plugin.cue": {
			seed: false
			text: H._header + strings.Replace(_schema, "\npackage releasecron\n", "\npackage \(H.package)\n", 1)
		}
		// The app's own: its opt-in. Not release-cron.cue: sayt's lint vets an X.cue against a
		// path X, and release-cron/ is this host's.
		"release_cron.cue": {
			seed: true
			text: """
				package \(H.package)

				// What release-cron releases of this app and how it checks production: the app's folder
				// watched (watch: [...] names others), each probe fetched from the release's domain once
				// it serves. The gap, the wake and each step's limit are #Cron's defaults.
				releaseCron: probes: home: {path: "/"}

				"""
		}
	}
}
