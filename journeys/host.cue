// The journeys host: journey monitoring for a pronto app, on unmodified
// pronto. An app declares its critical journeys as gestures on its screens,
// with SLOs; the terminal's telemetry (omnishell's docs/telemetry.md) is
// assembled into runs by a collector, burned against the budget by vmalert
// rules, and drawn by a Grafana dashboard, all generated from that one spec.
//
// pronto 0.14.0 has no journeys, so the host holds generated files, as the
// Android and Firebase hosts do: a seat beside pronto/config.cue's (a file of
// the same package unifies into `pronto` the way the bootstrap splits seats),
// the schema in the app's own package, and the step its generate runs after
// pronto's writer.
@extern(embed)

package journeys

import (
	"encoding/json"
	"strings"
)

_schema:     _ @embed(file="schema.cue", type=text)
_journeysNu: _ @embed(file="journeys.nu", type=text)
_telemetry:  _ @embed(file="telemetry.js", type=text)

// The gestures the terminal reports for a data-on-* handler, as omnishell
// publishes them (terminal.cue `capabilities.telemetry.gestures.events`).
_telemetryPath: "shell/hatches/journeys/telemetry.js"

// The local dashboard's images, pinned as pronto's observability stack pins
// VictoriaMetrics.
#DashboardImages: {
	victoriametrics: "victoriametrics/victoria-metrics:v1.106.1@sha256:54b283129634239db62798fd8d92e8d8d4372a0b114e72967eb233dbb264ff53"
	vmalert:         "victoriametrics/vmalert:v1.106.1@sha256:b546a4fbd2d382419dcf521caba096a1f09b15c9338c8f89fb009e5b8d0cfbce"
	grafana:         "grafana/grafana:11.2.0@sha256:408afb9726de5122b00a2576763a8a57a3c86d5b0eff5305bc994ceb3eb96c3f"
}

_dashboardCompose: """
	# generated by pronto-journeys from journeys/host.cue — do not edit
	# `journeys up` starts it on the app's network (JOURNEYS_NETWORK) as its own
	# project (JOURNEYS_PROJECT); `journeys down` stops it.
	name: ${JOURNEYS_PROJECT}
	services:
	  victoriametrics:
	    image: \(#DashboardImages.victoriametrics)
	    command: ["-promscrape.config=/etc/journeys/scrape.yaml", "-retentionPeriod=30d", "-httpListenAddr=:8428", "-search.latencyOffset=0s"]
	    configs: [{source: scrape, target: /etc/journeys/scrape.yaml}]
	    networks: [app]
	  vmalert:
	    image: \(#DashboardImages.vmalert)
	    command:
	      - -rule=/etc/journeys/rules.yaml
	      - -datasource.url=http://victoriametrics:8428
	      - -remoteWrite.url=http://victoriametrics:8428
	      - -remoteRead.url=http://victoriametrics:8428
	      - -notifier.blackhole
	      - -evaluationInterval=15s
	      - -rule.evalDelay=0s
	    configs: [{source: rules, target: /etc/journeys/rules.yaml}]
	    depends_on: [victoriametrics]
	    ports: ["8880"]
	    networks: [app]
	  grafana:
	    image: \(#DashboardImages.grafana)
	    environment:
	      GF_AUTH_ANONYMOUS_ENABLED: "true"
	      GF_AUTH_ANONYMOUS_ORG_ROLE: Admin
	      GF_AUTH_DISABLE_LOGIN_FORM: "true"
	      GF_DASHBOARDS_DEFAULT_HOME_DASHBOARD_PATH: /etc/grafana/provisioning/dashboards/journeys.dashboard.json
	    configs:
	      - {source: datasource, target: /etc/grafana/provisioning/datasources/journeys.yaml}
	      - {source: provider, target: /etc/grafana/provisioning/dashboards/journeys.yaml}
	      - {source: dashboard, target: /etc/grafana/provisioning/dashboards/journeys.dashboard.json}
	    depends_on: [victoriametrics]
	    ports: ["3000"]
	    networks: [app]
	networks:
	  app:
	    name: ${JOURNEYS_NETWORK}
	    external: true
	configs:
	  scrape:
	    content: |
	      global: {scrape_interval: 10s}
	      scrape_configs:
	        - job_name: journeys
	          static_configs: [{targets: ["journeys-collector:9598"]}]
	  rules: {file: ../observability/journeys.rules.yaml}
	  dashboard: {file: ../observability/journeys.dashboard.json}
	  datasource:
	    content: |
	      apiVersion: 1
	      datasources:
	        - {name: VictoriaMetrics, type: prometheus, uid: vm, url: "http://victoriametrics:8428", isDefault: true}
	  provider:
	    content: |
	      apiVersion: 1
	      providers:
	        - {name: journeys, type: file, options: {path: /etc/grafana/provisioning/dashboards}}

	"""

#GestureEvents: ["click", "dblclick", "change", "submit", "keydown", "drop"]

#Tools: {
	// promtool lints the rules the program's `journeys` check names.
	"github:prometheus/prometheus": "v3.5.0"
}


#Host: H={
	// The program's CUE package, which the schema and the derived gestures
	// join (program.cue's `package` line).
	package!: =~"^[a-z][a-z0-9_]*$"
	// Where the terminal posts and the door routes: same-origin, since the
	// terminal's policy is connect-src 'self'.
	endpoint: *"/telemetry" | =~"^/[a-z0-9/_-]+$"

	_header: "// generated by pronto-journeys from journeys/host.cue — do not edit\n"
	_step:   "use ./journeys/journeys.nu"
	_events: strings.Join(#GestureEvents, ",")

	// The generate rule, after pronto's writer (priority 1): the gestures are
	// read from the screens the writer just emitted, the shell config and the
	// door it just rewrote are given the endpoint again, and the program's
	// `journeys` is exported last, so it validates against this run's gestures.
	_generate: {
		priority: 2
		cmds: [{do: "use tools.nu [run-mise]; \(H._step); journeys derive \(H.package) \(H._events); journeys route \(H.endpoint); run-mise exec -- cue export . -e journeys.out --out json | journeys write"}]
	}

	// sayt's platform rule: the collector, and beside it a local dashboard to
	// watch the journeys move in (journeys up).
	_launch: {
		platform: "journeys"
		cmds: [{do: "\(H._step); journeys up"}]
	}

	files: {
		".say.json": {
			seed:  false
			merge: true
			text:  json.Indent(json.Marshal({say: launch: rulemap: journeys: H._launch}), "", "  ") + "\n"
		}
		// The seat: the tools and the generate rule, unified into `pronto`.
		"pronto/journeys.cue": {
			seed: false
			text: H._header + """
				package prontoproject

				pronto: {
					tools: \(json.Marshal(#Tools))
					say: say: generate: rulemap: journeys: \(json.Marshal(H._generate))
				}

				"""
		}
		// The schema, in the program's package.
		"journeys_plugin.cue": {
			seed: false
			text: H._header + strings.Replace(_schema, "\npackage journeys\n", "\npackage \(H.package)\n", 1)
		}
		// Until the first generate derives them, no screen has gestures.
		"journeys_gestures.cue": {
			seed: true
			text: H._header + "package \(H.package)\n\n_journeyGestures: {}\n"
		}
		// The app's own: which journeys it promises, and the check that their
		// rules parse.
		// Not journeys.cue: sayt's lint vets an X.cue against a path X, and
		// journeys/ is this host's.
		"journeys_spec.cue": {
			seed: true
			text: """
				package \(H.package)

				// The journeys this app promises: each an ordered list of
				// `screen.gesture` moments — a handler by its module, a form by its
				// id, else its action and entity (journeys_gestures.cue lists them) —
				// with an availability target and optionally a latency one.
				//
				//	spec: checkout: {
				//		owner:   "payments"
				//		moments: ["cart.view", "cart.pay"]
				//		slo: {availability: 99.9, latency: {percent: 95, under: "3s"}}
				//	}
				journeys: #Journeys & {gestures: _journeyGestures, spec: {}}

				loop: surface: checks: journeys.checks

				"""
		}
		"journeys/journeys.nu": {seed: false, text: _journeysNu}
		// The local dashboard `journeys up` starts on the app's network:
		// VictoriaMetrics scraping the collector, vmalert burning the budget
		// with the generated rules, Grafana drawing the generated dashboard.
		"journeys/dashboard.compose.yaml": {seed: false, text: _dashboardCompose}
		(_telemetryPath): {seed: false, text: strings.Replace(_telemetry, "__ENDPOINT__", H.endpoint, 1)}
		// The collector: a container hatch, pronto's word for a service it is
		// told not to look inside, whose definition is the program's cluster
		// unification beside it. Vector, with this app's run assembly baked in,
		// never mounted. The ir owes it a data-kind="hatch" element.
		"journeys_hatch.cue": {
			seed: false
			text: H._header + """
				package \(H.package)

				import (
					"list"
					"strings"
				)

				// The terminal's reporter: a host-DOM hatch on every screen, reading
				// the reader's gestures and the screen's state (telemetry.js).
				code: capabilities: hatches: "journeys-telemetry": {
					kind:  "host-dom"
					src:   "\(_telemetryPath)"
					files: ["\(_telemetryPath)"]
					note:  "pronto-journeys' reporter: posts each gesture and its outcome, read from the screen's data-state, to \(H.endpoint)"
				}
				// Every screen gets the reporter. A screen with hatches of its own names
				// the reporter among them, and the app lists it in _journeysOwnHatches
				// so this does not; vet lists any screen left without it.
				_journeysOwnHatches: *[] | [...string]
				code: surface: screens: [!~"^(\\(strings.Join(_journeysOwnHatches, "|")))$"]: hatches: ["journeys-telemetry"]
				_journeysUnreported: [for n, s in code.surface.screens if !list.Contains(s.hatches, "journeys-telemetry") {n}] & []

				code: capabilities: hatches: "journeys-collector": {
					kind: "container"
					note: "pronto-journeys' collector: Vector assembling the terminal's telemetry into journey runs"
				}

				cluster: surface: targets: "journeys-collector": {
					srcs: globs: ["observability/journeys.collector.yaml"]
					dockerfile: {
						from: name: "\(#JourneysVector)"
						copy: [{srcs: ["observability/journeys.collector.yaml"], dst: "/etc/vector/vector.yaml"}]
					}
					compose: restart: "on-failure"
				}

				"""
		}
	}
}
