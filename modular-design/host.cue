// The modular-design host: an app's design split into modules, small CUE packages each evaluated and exported on its own
// (README.md). pronto has no such thing, so the host holds generated files, as the perf host does: a seat beside
// pronto/config.cue's with the generate rule, the schema in the app's own package, the build step and the lint.
// What the app owns, written once and kept: modules.cue, the schema module, an example module and the join's package.
@extern(embed)

package modulardesign

import (
	"encoding/json"
	"strings"
)

_schema:        _ @embed(file="schema.cue", type=text)
_modulesSchema: _ @embed(file="modules_schema.cue.txt", type=text)
_buildNu:       _ @embed(file="build.nu", type=text)
_lintTs:        _ @embed(file="lint.ts", type=text)

#Host: H={
	// The program's CUE package, which the schema joins.
	package!: =~"^[a-z][a-z0-9_]*$"
	// The app's CUE module path, without its major version (cue.mod/module.cue): what a module imports the schema by.
	module!: string
	// Whether the app has no modules yet: then the schema module, an example module and the join's package are seeded.
	fresh: *true | bool

	_header: "// generated by pronto-modular-design from modular-design/host.cue — do not edit\n"

	// The generate rule runs before pronto's writer (priority 1): the writer evaluates the program, which reads what
	// the modules export, so the exports must exist when it runs.
	_generate: {
		priority: -1
		cmds: [{do: "use tools.nu [run-mise]; run-mise exec -- nu modules/build.nu"}]
	}

	files: {
		"pronto/modular_design.cue": {
			seed: false
			text: H._header + """
				package prontoproject

				pronto: say: say: generate: rulemap: modules: \(json.Marshal(H._generate))

				"""
		}
		"modular_design_plugin.cue": {
			seed: false
			text: H._header + strings.Replace(_schema, "\npackage modulardesign\n", "\npackage \(H.package)\n", 1)
		}
		// The app's own: it opts the lint into the program's checks.
		"modular_design_spec.cue": {
			seed: true
			text: """
				package \(H.package)

				// The modules' lint (modules/lint.ts) runs in `test`.
				modularDesign: #ModularDesign & {}

				loop: surface: checks: modularDesign.checks

				"""
		}
		"modules/modules_plugin.cue": {
			seed: false
			text: H._header + _modulesSchema
		}
		"modules/build.nu": {seed: false, text: _buildNu}
		"modules/lint.ts": {seed: false, text: _lintTs}

		if H.fresh {
			"modules/modules.cue": {
				seed: true
				text: """
					package modules

					// The app's modules. `schema` is the module every other imports as CUE; each of the others is read through
					// its export. `join` says where an export is also written, for the package that joins the modules.
					modules: #Modules & {
						schema: {}
						// An example: replace it with the app's own families.
						example: {
							needs: ["schema"]
							expr: "out"
							join: "join/example.json"
							owns: ["items.example"]
						}
					}

					"""
			}
			"modules/schema/schema.cue": {
				seed: true
				text: """
					package schema

					// What the modules share: definitions, which do not survive an export, and a schema is cheap to evaluate.
					#Item: {
						id: string & !=""
						n:  int & >=0
					}

					"""
			}
			"modules/example/example.cue": {
				seed: true
				text: """
					package example

					import schema "\(H.module)/modules/schema"

					// What this module writes, checked against the schema it shares.
					items: [...schema.#Item] & [{id: "a", n: 1}, {id: "b", n: 2}]

					// What it exports: the join reads it, and a module that needs this one reads it through deps/.
					out: {"items": items}

					"""
			}
			"join/join.cue": {
				seed: true
				text: """
					@extern(embed)

					package join

					import "list"

					// The package that joins the modules: it embeds their exports (written by modules/build.nu) and checks only
					// what spans modules.
					_example: _ @embed(file="example.json")

					items: _example.items & list.UniqueItems()

					"""
			}
		}
	}
}
