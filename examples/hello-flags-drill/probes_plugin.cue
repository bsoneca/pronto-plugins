// generated by pronto-probe from probe/host.cue — do not edit
// What pronto-probe (README.md) reads of an app: the journeys it runs against the released app
// on a schedule, and where. A journey is data, written once in the app's probes_spec.cue; the
// state machine that turns runs into an alert is probe.js, held by tests/unit/probe.cue.
// bin/pronto-probe writes this file into the app's own package (probes_plugin.cue).
package drill

_duration: =~"^[0-9]+(ms|s|m|h)$"

#Probe: {
	// Why this journey is the one to watch.
	note?: string
	// How often the whole journey runs.
	every: *"15s" | _duration
	// How long a step may take before it counts as failed.
	timeout: *"5s" | _duration
	// The steps, in order: the first to fail fails the run.
	journey: [#Step, ...#Step]
	alert: {
		// Consecutive failed runs before the alert (one failure is a blip).
		after: *2 | (int & >0)
		// How far before the first failure a flag write is a suspect.
		suspectWindow: *"15m" | _duration
	}
}

#Step: {
	name!:  string & !=""
	method: *"GET" | "POST"
	// Joined to probeTarget.url.
	path!: string & =~"^/"
	body?: _
	expect: {
		status: *200 | int
		// A text the response body holds.
		contains?: string
	}
}

probes: [=~"^[a-z][a-z0-9_-]*$"]: #Probe

#Target: {
	// The app's base address, no trailing slash.
	url!: string & !~"/$"
	// Where pronto-flags journals its writes, when not its default
	// (${XDG_STATE_HOME:-~/.local/state}/pronto-flags/<app>.jsonl).
	flagsJournal?: string
}
probeTarget?: #Target
