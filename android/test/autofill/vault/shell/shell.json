{
  "app": "prontokeep",
  "floors": {
    "touch": 24
  },
  "i18n": {
    "default": "en",
    "locales": {
      "en": {
        "path": "en"
      }
    }
  },
  "local": {
    "login": "device",
    "probe": "tab",
    "candidate": "tab"
  },
  "seed": {
    "probe": [
      {
        "id": "probe",
        "kind": "web",
        "target": "",
        "signers": ""
      }
    ]
  },
  "server": false,
  "routes": [
    {
      "path": "/",
      "screen": "vault",
      "nav": {
        "key": "nav_vault",
        "label": "Vault"
      },
      "files": {
        "html": "shell/screens/vault.html",
        "css": "shell/screens/vault.css",
        "handlers": [
          "shell/handlers/match.js",
          "shell/handlers/remove.js"
        ],
        "adapters": [],
        "shared": []
      },
      "ssr": "spa",
      "states": [
        "empty",
        "populated"
      ]
    }
  ],
  "tables": [],
  "schema": {
    "login": {
      "durability": "device",
      "fields": [
        {
          "name": "id",
          "pk": true,
          "type": "uuid",
          "required": true
        },
        {
          "bounds": {
            "sizeMin": 1,
            "sizeMax": 80
          },
          "name": "title",
          "type": "string",
          "required": true
        },
        {
          "bounds": {
            "sizeMax": 120
          },
          "name": "username",
          "type": "string",
          "required": true
        },
        {
          "bounds": {
            "sizeMin": 1,
            "sizeMax": 256
          },
          "name": "secret",
          "type": "string",
          "required": true
        },
        {
          "bounds": {
            "sizeMax": 253,
            "regex": "^[a-z0-9_-]+(\\.[a-z0-9_-]+)+$"
          },
          "name": "target",
          "type": "string",
          "required": true
        },
        {
          "name": "created",
          "type": "timestamp",
          "required": true
        },
        {
          "enum": [
            "web",
            "app"
          ],
          "name": "kind",
          "type": "string",
          "required": true
        },
        {
          "bounds": {
            "regex": "^([0-9a-f]{64}(\\+[0-9a-f]{64})*)?$"
          },
          "name": "signer",
          "type": "string",
          "required": true
        }
      ]
    },
    "probe": {
      "durability": "tab",
      "fields": [
        {
          "enum": [
            "probe"
          ],
          "name": "id",
          "pk": true,
          "type": "string",
          "required": true
        },
        {
          "enum": [
            "web",
            "app"
          ],
          "name": "kind",
          "type": "string",
          "required": true
        },
        {
          "bounds": {
            "sizeMax": 253
          },
          "name": "target",
          "type": "string",
          "required": true
        },
        {
          "bounds": {
            "sizeMax": 2048
          },
          "name": "signers",
          "type": "string",
          "required": true
        }
      ]
    },
    "candidate": {
      "durability": "tab",
      "fields": [
        {
          "name": "id",
          "pk": true,
          "type": "string",
          "required": true
        },
        {
          "name": "title",
          "type": "string",
          "required": true
        },
        {
          "name": "username",
          "type": "string",
          "required": true
        }
      ]
    }
  },
