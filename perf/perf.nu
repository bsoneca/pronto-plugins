# The perf host's generate step, run by the rule pronto/perf.cue adds, after
# pronto's writer. Written by pronto-perf; regenerated, do not edit.

const begin = "  # pronto-perf:begin — the reporter's batches, to the perf collector"
const end = "  # pronto-perf:end"

# A file rewritten only when its text changes, so a generate that changes
# nothing leaves every watch and build cache where it was.
def save-changed [path: path] {
	let text = $in
	if not ($path | path exists) or (open --raw $path) != $text {
		mkdir ($path | path dirname)
		$text | save --force --raw $path
	}
}

# The door's route to the collector, which pronto's writer regenerates without
# it. An earlier run's goes first, so a changed endpoint replaces the old one.
export def route [endpoint: string] {
	let route = [
		$begin
		$"  handle ($endpoint) {"
		# A report is a few hundred bytes; a batch a few kilobytes.
		"    request_body {"
		"      max_size 32KB"
		"    }"
		"    rewrite * /perf"
		"    reverse_proxy {$PRONTO_UPSTREAM_PERF_COLLECTOR:perf-collector:8687} {"
		"      header_up dapr-app-id perf-collector"
		"      header_up Host {upstream_hostport}"
		"    }"
		"  }"
		$end
	]
	let all = open --raw docker/Caddyfile | lines
	let from = $all | enumerate | where item == $begin | get index.0?
	let to = $all | enumerate | where item == $end | get index.0?
	let lines = if $from == null or $to == null { $all } else { [...($all | first $from) ...($all | skip ($to + 1))] }
	# Into the (app) snippet every listener imports, before its first route and
	# the comment that route carries.
	let at = $lines | enumerate | where {|l| $l.item | str starts-with "  handle /auth/*"} | get index.0?
	if $at == null { error make {msg: "docker/Caddyfile has no `handle /auth/*` to place the perf route before"} }
	# Another host's block ends with its end marker, which is no comment of this route's.
	let start = $at - ($lines | first $at | reverse | take while {|l| ($l | str starts-with "  #") and not ($l | str ends-with ":end")} | length)
	[...($lines | first $start) ...$route ...($lines | skip $start)] | str join "\n" | $"($in)\n" | save-changed docker/Caddyfile
}

# The program's `perf.out`, as `cue export -e perf.out --out json` gives it:
# the reporter's settings beside its module, the rest into observability/ as
# YAML or JSON by each name's extension.
export def write [] {
	let out = $in | from json
	for f in ($out | columns) {
		let value = $out | get $f
		if $f == "perf.reporter.json" {
			$"// generated by pronto-perf from the app's perf_spec.cue — do not edit\nexport default ($value | to json --raw);\n" | save-changed shell/hatches/perf/config.js
		} else {
			(if ($f | str ends-with ".yaml") { $value | to yaml } else { $value | to json --indent 2 }) | save-changed $"observability/($f)"
		}
	}
}

# The collector on a host, as process-compose runs it: its config with the
# ports the launch gave it, which Vector will not read from the environment.
export def collect [] {
	let http = $env.PERF_HTTP_PORT? | default "8687"
	let metrics = $env.PERF_METRICS_PORT? | default "9599"
	let config = mktemp --suffix .yaml
	open --raw observability/perf.collector.yaml
		| str replace '0.0.0.0:8687' $"127.0.0.1:($http)"
		| str replace '0.0.0.0:9599' $"127.0.0.1:($metrics)"
		| save --force --raw $config
	exec vector --quiet --config $config
}

# What the collector has counted, by screen, GPU and browser: frames, their
# p95, long frames, and contexts lost. Reads its Prometheus export (the
# metrics port the launch gave it, or `url`).
export def report [url?: string] {
	let at = $url | default $"http://127.0.0.1:($env.PERF_METRICS_PORT? | default '9599')/metrics"
	let samples = http get --raw $at | lines | where {|l| not ($l | str starts-with "#") and ($l | str trim) != ""} | each {|l|
		let m = $l | parse --regex '^(?<name>[a-z_]+)(\{(?<labels>[^}]*)\})? (?<value>[0-9.e+-]+)'
		if ($m | is-empty) { null } else {
			let labels = $m.0.labels | parse --regex '(?<k>[a-z_]+)="(?<v>[^"]*)"' | reduce --fold {} {|kv, acc| $acc | insert $kv.k $kv.v }
			{name: $m.0.name, labels: $labels, value: ($m.0.value | into float)}
		}
	} | compact
	let key = {|s| $"($s.labels.screen? | default '-')/($s.labels.gpu? | default '-')/($s.labels.browser? | default '-')/($s.labels.tier? | default '-')"}
	let frames = $samples | where name == "perf_frame_seconds_bucket" | insert key {|s| do $key $s} | group-by key --to-table | each {|g|
		let buckets = $g.items | each {|s| {le: $s.labels.le, n: $s.value}} | group-by le | items {|le, xs| {le: $le, n: ($xs | get n | math sum)}}
		let total = $buckets | where le == "+Inf" | get n.0? | default 0 | into int
		let p95 = $buckets | where le != "+Inf" | update le {into float} | sort-by le | where n >= ($total * 0.95) | get le.0? | default "> last"
		let long = $samples | where name == "perf_long_frames_total" | where {|s| (do $key $s) == $g.key} | get value | append 0.0 | math sum | into int
		{"screen/gpu/browser/tier": $g.key, frames: $total, "p95 ≤ s": $p95, long: $long}
	}
	print ($frames | sort-by frames --reverse)
	let lost = $samples | where name == "perf_webgl_context_lost_total"
	let sessions = $samples | where name == "perf_sessions_total" | get value | append 0.0 | math sum | into int
	print $"sessions ($sessions) · contexts lost ($lost | get value | append 0.0 | math sum | into int)"
}
