// generated by pronto-billing from billing/app/ — do not edit
package __PACKAGE__

import (
	"crypto/sha256"
	"encoding/hex"
	"encoding/json"
	"strconv"
	"strings"
	"time"

	bayt "github.com/bonisoft3/bayt/core:bayt"
)

// What the app sells, through the operator's billing broker: the hash of its
// author's payout secret, and its plans (billing_spec.cue says them).
#Billing: {
	// The broker as readers reach it (its issuer), and as the cluster does.
	broker:          string
	brokerInternal?: string
	// ownerOf the author's secret (pronto-billing's billing/owner.ts new).
	owner: =~"^[A-Za-z0-9_-]{43}$"
	plans: [=~"^[a-z][a-z0-9-]{0,31}$"]: {
		name:     strings.MinRunes(1) & strings.MaxRunes(80)
		interval: *"month" | "year"
		// In minor units, the first the default: {usd: 499, brl: 1990}.
		prices: [=~"^(usd|brl|eur|gbp)$"]: int & >=50 & <=1000000
	}
	// Plans the author gives accounts free, each through the end of a day, in UTC:
	// {"<account>": {analysis: "2027-01-31"}}. One past is no plan; one taken out
	// of here is no row either, once the service reads the set again: with
	// pronto-flags (_billingFlags), within a minute of `pronto-flags push`; else
	// once the release that carries it starts.
	grants: [=~"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"]: close({
		[or([for p, _ in plans {p}])]: time.Format("2006-01-02")
	})
	// An opt-in free trial, which an account chooses and consents to: `months` of the plan
	// free, charged from the day it ends unless cancelled before. Published with the plans,
	// so a broker that does not know trials still sees a document it can read, and offers none.
	// `remindDays` is how long before the first charge the app reminds the account.
	let sold = [for p, _ in plans {p}]
	trial?: {
		months: int & >=1 & <=23
		plans: [_, ...] & [...or(sold)]
		remindDays: int & >=1 | *7
	}
}
billing: #Billing
// Inside the billing target, `billing` is the target: the spec is _billing there.
_billing: billing
_billingDocument: json.Marshal({owner: _billing.owner, plans: _billing.plans, if _billing.trial != _|_ {trial: _billing.trial}})
_billingGrants: (#billingGrants & {grants: _billing.grants}).out

// Where the service reads the grants live, when the app has pronto-flags: the
// origin of a flagd that serves OFREP, or "origin" for the app's own door, which
// routes /ofrep/ to its flagd (a release, where flagd runs apart and only the
// door reaches it: its release.cue says `sidecars: billing: env: BILLING_FLAGS:
// "origin"`). Set, the grants are the flag billing_grants too, which
// `pronto-flags push` changes with no deploy, and the service reads it every
// minute; unset, it takes them once, from BILLING_GRANTS, as it starts. A
// flag is read by anyone who asks the door for it: so are the grants.
_billingFlags: *"" | "origin" | =~"^https?://[^/]+$"
if _billingFlags != "" {
	flags: billing_grants: {
		note:    "pronto-billing's grants (billing_spec.cue's billing.grants), which the billing service reads every minute: a push gives or takes a plan with no deploy. Not a switch: edit billing.grants, never this."
		default: _billingGrants
	}
}

// The grants as the service hands them to billing_grant: a row each, through
// the day's last second.
#billingGrants: {
	grants: _
	out: json.Marshal([for a, g in grants for p, d in g {account: a, plan: p, through: "\(d)T23:59:59Z"}])
}

// The flag the free trial is behind, evaluated per account by the service (OFREP, through
// _billingFlags): the document's trial is on only where the flag says true. Empty, the trial is
// on wherever the document has one.
_billingTrialFlag: *"" | string

_billingGrantsChecks: {
	none: (#billingGrants & {grants: {}}).out & "[]"
	two: (#billingGrants & {grants: "00000000-0000-4000-8000-00000000000a": {analysis: "2027-01-31", coach: "2026-12-24"}}).out &
		"[{\"account\":\"00000000-0000-4000-8000-00000000000a\",\"plan\":\"analysis\",\"through\":\"2027-01-31T23:59:59Z\"},{\"account\":\"00000000-0000-4000-8000-00000000000a\",\"plan\":\"coach\",\"through\":\"2026-12-24T23:59:59Z\"}]"
	// Refused: a plan the app does not sell, a day that is no day, an account that is no uuid.
	_spec: {owner: "o" * 43, broker: "http://localhost:28463", plans: analysis: {name: "A", prices: usd: 499}}
	unsold: (#Billing & _spec & {grants: "00000000-0000-4000-8000-00000000000a": coach: "2027-01-31"}) == _|_ & true
	noDay: (#Billing & _spec & {grants: "00000000-0000-4000-8000-00000000000a": analysis: "2027-02-30"}) == _|_ & true
	noUuid: (#Billing & _spec & {grants: "ana": analysis: "2027-01-31"}) == _|_ & true
	accepted: (#Billing & _spec & {grants: "00000000-0000-4000-8000-00000000000a": analysis: "2027-01-31"}) != _|_ & true
	// A trial: of plans the app sells, 1 to 23 months, the reminder 7 days unless said.
	trialUnsold: (#Billing & _spec & {trial: {months: 3, plans: ["coach"]}}) == _|_ & true
	trialNoPlan: (#Billing & _spec & {trial: {months: 3, plans: []}}) == _|_ & true
	trialLong: (#Billing & _spec & {trial: {months: 24, plans: ["analysis"]}}) == _|_ & true
	trialOk: (#Billing & _spec & {trial: {months: 3, plans: ["analysis"]}}) != _|_ & true
	trialRemind: (#Billing & _spec & {trial: {months: 3, plans: ["analysis"]}}).trial.remindDays & 7
}

// Each plan an account holds, and until when: the broker's word, which only
// the database writes (the billing migration); the account reads its own. Its type id is
// the app's, minted into billing_spec.cue.
code: state: entities: {
	Subscription: {
		table:      "subscription"
		durability: "live"
		access: {scope: "private", owner: "owner_id"}
		fields: [
			// The plan and the account: "<plan>/<account>".
			{ordinal: 1, name: "id", type: "text", pk: true, cel: "this.size() <= 80"},
			{ordinal: 2, name: "plan", type: "text", cel: "this.size() <= 32"},
			{ordinal: 3, name: "active", type: "bool"},
			// Paid through; a lapsed plan's is the epoch.
			{ordinal: 4, name: "through", type: "timestamp"},
			// The broker's ordering: a push older than the row is dropped.
			{ordinal: 5, name: "ver", type: "int64", cel: "this >= 0"},
			{ordinal: 6, name: "owner_id", type: "uuid", default: "auth_uid()"},
		]
	}
}

// The broker's entitlements reach the table only through billing_entitle, as
// the service; a session may read its own rows and write none. A paid
// feature's own gate reads the table: whether the session's account holds
// the plan, active and paid through now. The token an
// account manages its subscriptions with stays in a schema the REST gateway
// does not serve, and the service alone reads it back.
// Named by the app (billing_spec.cue), so it sorts among the app's own: pgroll applies a set in
// name order, and a name before the last applied is refused.
_billingMigration: string
code: state: migrations: "\(_billingMigration)": operations: [{sql: up: """
	CREATE SCHEMA IF NOT EXISTS billing;
	REVOKE ALL ON SCHEMA billing FROM PUBLIC;
	CREATE TABLE IF NOT EXISTS billing.manage (account uuid PRIMARY KEY, token text NOT NULL, ver bigint NOT NULL DEFAULT 0);

	CREATE OR REPLACE FUNCTION billing.sessions_read_only() RETURNS trigger LANGUAGE plpgsql AS $f$
	BEGIN
	  IF current_user IN ('app_user', 'anon') THEN
	    RAISE EXCEPTION 'subscriptions are the billing broker''s to write' USING ERRCODE = 'insufficient_privilege';
	  END IF;
	  RETURN coalesce(NEW, OLD);
	END $f$;
	DROP TRIGGER IF EXISTS subscription_read_only ON public.subscription;
	CREATE TRIGGER subscription_read_only BEFORE INSERT OR UPDATE OR DELETE ON public.subscription
	  FOR EACH ROW EXECUTE FUNCTION billing.sessions_read_only();
	-- Whatever a session wrote before the trigger stood (a release between its initdb and this
	-- migration): a row the broker did not write is no plan.
	DELETE FROM public.subscription s WHERE s.id <> s.plan || '/' || s.owner_id
	  OR NOT EXISTS (SELECT 1 FROM billing.manage m WHERE m.account = s.owner_id);

	CREATE OR REPLACE FUNCTION public.billing_entitle(account uuid, plan text, active boolean, through timestamptz, manage text, ver bigint)
	RETURNS void LANGUAGE plpgsql SECURITY DEFINER SET search_path = pg_catalog, public AS $f$
	BEGIN
	  -- The constraints by name: a column by its name would be the parameter of that name.
	  INSERT INTO billing.manage AS m (account, token, ver) VALUES (account, manage, ver)
	    ON CONFLICT ON CONSTRAINT manage_pkey DO UPDATE SET token = EXCLUDED.token, ver = EXCLUDED.ver
	    WHERE m.ver < EXCLUDED.ver;
	  INSERT INTO public.subscription AS s (id, plan, active, through, ver, owner_id)
	    VALUES (plan || '/' || account, plan, active, through, ver, account)
	    ON CONFLICT ON CONSTRAINT subscription_pkey DO UPDATE SET active = EXCLUDED.active, through = EXCLUDED.through, ver = EXCLUDED.ver
	    WHERE s.ver < EXCLUDED.ver;
	END $f$;
	REVOKE ALL ON FUNCTION public.billing_entitle(uuid, text, boolean, timestamptz, text, bigint) FROM PUBLIC;
	GRANT EXECUTE ON FUNCTION public.billing_entitle(uuid, text, boolean, timestamptz, text, bigint) TO service;

	CREATE OR REPLACE FUNCTION public.billing_manage(account uuid) RETURNS text
	LANGUAGE sql STABLE SECURITY DEFINER SET search_path = pg_catalog, public AS $f$
	  SELECT m.token FROM billing.manage m WHERE m.account = billing_manage.account
	$f$;
	REVOKE ALL ON FUNCTION public.billing_manage(uuid) FROM PUBLIC;
	GRANT EXECUTE ON FUNCTION public.billing_manage(uuid) TO service;

	-- Who a reader is, as the gateway verified their session: what the billing
	-- service asks before it sends anyone to pay or to manage.
	CREATE OR REPLACE FUNCTION public.billing_me() RETURNS json
	LANGUAGE sql STABLE SET search_path = pg_catalog, public AS $f$
	  SELECT json_build_object('account', auth_uid(),
	    'guest', coalesce((nullif(current_setting('request.jwt.claims', true), '')::jsonb ->> 'guest')::boolean, false))
	$f$;
	REVOKE ALL ON FUNCTION public.billing_me() FROM PUBLIC;
	GRANT EXECUTE ON FUNCTION public.billing_me() TO app_user;

	NOTIFY pgrst, 'reload schema';
	"""}]

// The author's grants (billing.grants), written as the broker's entitlements are,
// into the rows the paid feature's gate and its pages already read. A grant's row
// is the one whose ver is 0: the broker's ver is its clock, never 0, so a payment
// always outranks a grant, and a grant takes no row the broker holds while it is
// paid through. The service hands the whole set over as it starts, so a grant
// taken out of the spec leaves no row behind.
_billingGrantsMigration: string
code: state: migrations: "\(_billingGrantsMigration)": operations: [{sql: up: """
	CREATE OR REPLACE FUNCTION public.billing_grant(grants json) RETURNS void
	LANGUAGE plpgsql SECURITY DEFINER SET search_path = pg_catalog, public AS $f$
	BEGIN
	  DELETE FROM public.subscription s WHERE s.ver = 0 AND NOT EXISTS (
	    SELECT 1 FROM json_to_recordset(grants) AS g(account uuid, plan text, through timestamptz) WHERE s.id = g.plan || '/' || g.account);
	  INSERT INTO public.subscription AS s (id, plan, active, through, ver, owner_id)
	    SELECT g.plan || '/' || g.account, g.plan, true, g.through, 0, g.account
	    FROM json_to_recordset(grants) AS g(account uuid, plan text, through timestamptz)
	    ON CONFLICT ON CONSTRAINT subscription_pkey DO UPDATE SET active = true, through = EXCLUDED.through, ver = 0
	    WHERE s.ver = 0 OR NOT (s.active AND s.through > now());
	END $f$;
	REVOKE ALL ON FUNCTION public.billing_grant(json) FROM PUBLIC;
	GRANT EXECUTE ON FUNCTION public.billing_grant(json) TO service;
	NOTIFY pgrst, 'reload schema';
	"""}]

// The free trial (billing.trial), kept apart from billing_01's tables so an app that offers
// none has them all the same and nothing reads them. Only the service writes it, as the broker's
// entitlements are written. A row is born at an account's consent, with a ticket the broker
// gives back once (billing_trial_take) to prove the account asked, its state null until Stripe
// confirms the trial (billing_trial_state). The trial is spent for good once its state is set.
// Named by the app (billing_spec.cue), after the grants' migration.
_billingTrialMigration: string
code: state: migrations: "\(_billingTrialMigration)": operations: [{sql: up: """
	CREATE TABLE IF NOT EXISTS billing.trial (
	  account uuid PRIMARY KEY, ticket text, plan text, amount integer, currency text, charges_at timestamptz,
	  terms text, consented_at timestamptz, state text, ver bigint NOT NULL DEFAULT 0,
	  CONSTRAINT trial_state CHECK (state IS NULL OR state IN ('running', 'cancelled', 'converted', 'ended', 'failed'))
	);

	-- Where an account's trial stands; holds is whether it has a plan now (paid or granted), which
	-- is no time for a trial. The consent of a trial not yet confirmed is nobody's to read.
	CREATE OR REPLACE FUNCTION public.billing_trial_status(account uuid) RETURNS json
	LANGUAGE sql STABLE SECURITY DEFINER SET search_path = pg_catalog, public AS $f$
	  SELECT json_build_object('state', t.state, 'plan', t.plan, 'amount', t.amount, 'currency', t.currency, 'charges_at', t.charges_at,
	    'holds', EXISTS (SELECT 1 FROM public.subscription s WHERE s.owner_id = billing_trial_status.account AND s.active AND s.through > now()))
	  FROM (SELECT 1) one LEFT JOIN billing.trial t ON t.account = billing_trial_status.account AND t.state IS NOT NULL
	$f$;
	REVOKE ALL ON FUNCTION public.billing_trial_status(uuid) FROM PUBLIC;
	GRANT EXECUTE ON FUNCTION public.billing_trial_status(uuid) TO service;

	-- A ticket for the broker to ask the service about: with a consent, what the account agreed to;
	-- without, an offer's. A consent is refused once the trial is spent.
	CREATE OR REPLACE FUNCTION public.billing_trial_ask(account uuid, plan text, amount integer, currency text, charges_at timestamptz, terms text)
	RETURNS text LANGUAGE plpgsql SECURITY DEFINER SET search_path = pg_catalog, public AS $f$
	DECLARE made text := replace(gen_random_uuid()::text || gen_random_uuid()::text, '-', '');
	BEGIN
	  IF plan IS NOT NULL AND EXISTS (SELECT 1 FROM billing.trial t WHERE t.account = billing_trial_ask.account AND t.state IS NOT NULL) THEN
	    RAISE EXCEPTION 'the free trial is spent' USING ERRCODE = 'check_violation';
	  END IF;
	  INSERT INTO billing.trial AS t (account, ticket, plan, amount, currency, charges_at, terms, consented_at)
	    VALUES (account, made, plan, amount, currency, charges_at, terms, CASE WHEN plan IS NULL THEN NULL ELSE now() END)
	    ON CONFLICT ON CONSTRAINT trial_pkey DO UPDATE SET ticket = EXCLUDED.ticket,
	      plan = CASE WHEN t.state IS NULL THEN EXCLUDED.plan ELSE t.plan END,
	      amount = CASE WHEN t.state IS NULL THEN EXCLUDED.amount ELSE t.amount END,
	      currency = CASE WHEN t.state IS NULL THEN EXCLUDED.currency ELSE t.currency END,
	      charges_at = CASE WHEN t.state IS NULL THEN EXCLUDED.charges_at ELSE t.charges_at END,
	      terms = CASE WHEN t.state IS NULL THEN EXCLUDED.terms ELSE t.terms END,
	      consented_at = CASE WHEN t.state IS NULL THEN EXCLUDED.consented_at ELSE t.consented_at END;
	  RETURN made;
	END $f$;
	REVOKE ALL ON FUNCTION public.billing_trial_ask(uuid, text, integer, text, timestamptz, text) FROM PUBLIC;
	GRANT EXECUTE ON FUNCTION public.billing_trial_ask(uuid, text, integer, text, timestamptz, text) TO service;

	-- The consent a ticket stands for, once: the ticket is spent as it is taken.
	CREATE OR REPLACE FUNCTION public.billing_trial_take(account uuid, ticket text) RETURNS json
	LANGUAGE sql SECURITY DEFINER SET search_path = pg_catalog, public AS $f$
	  UPDATE billing.trial t SET ticket = NULL
	  WHERE t.account = billing_trial_take.account AND t.ticket IS NOT NULL AND t.ticket = billing_trial_take.ticket
	  RETURNING json_build_object('plan', t.plan, 'amount', t.amount, 'currency', t.currency, 'charges_at', t.charges_at, 'terms', t.terms)
	$f$;
	REVOKE ALL ON FUNCTION public.billing_trial_take(uuid, text) FROM PUBLIC;
	GRANT EXECUTE ON FUNCTION public.billing_trial_take(uuid, text) TO service;

	-- The broker's word on the trial, ordered by its ver as an entitlement is.
	CREATE OR REPLACE FUNCTION public.billing_trial_state(account uuid, state text, plan text, amount integer, currency text, charges_at timestamptz, ver bigint)
	RETURNS void LANGUAGE plpgsql SECURITY DEFINER SET search_path = pg_catalog, public AS $f$
	BEGIN
	  INSERT INTO billing.trial AS t (account, plan, amount, currency, charges_at, state, ver)
	    VALUES (account, plan, amount, currency, charges_at, state, ver)
	    ON CONFLICT ON CONSTRAINT trial_pkey DO UPDATE SET plan = EXCLUDED.plan, amount = EXCLUDED.amount, currency = EXCLUDED.currency,
	      charges_at = EXCLUDED.charges_at, state = EXCLUDED.state, ver = EXCLUDED.ver
	    WHERE t.ver < EXCLUDED.ver;
	END $f$;
	REVOKE ALL ON FUNCTION public.billing_trial_state(uuid, text, text, integer, text, timestamptz, bigint) FROM PUBLIC;
	GRANT EXECUTE ON FUNCTION public.billing_trial_state(uuid, text, text, integer, text, timestamptz, bigint) TO service;

	-- Whether an account is on a trial that has not yet charged it, for analytics to keep it
	-- apart from paying subscribers.
	CREATE OR REPLACE FUNCTION public.billing_on_trial(account uuid) RETURNS boolean
	LANGUAGE sql STABLE SECURITY DEFINER SET search_path = pg_catalog, public AS $f$
	  SELECT EXISTS (SELECT 1 FROM billing.trial t WHERE t.account = billing_on_trial.account AND t.state IN ('running', 'cancelled'))
	    AND EXISTS (SELECT 1 FROM public.subscription s WHERE s.owner_id = billing_on_trial.account AND s.active AND s.through > now())
	$f$;
	REVOKE ALL ON FUNCTION public.billing_on_trial(uuid) FROM PUBLIC;
	GRANT EXECUTE ON FUNCTION public.billing_on_trial(uuid) TO service;
	-- An analytics view runs as the function's own owner; the viewer role is granted where an app has it.
	DO $g$ BEGIN
	  IF EXISTS (SELECT 1 FROM pg_roles WHERE rolname = 'analytics_viewer') THEN
	    GRANT EXECUTE ON FUNCTION public.billing_on_trial(uuid) TO analytics_viewer;
	  END IF;
	END $g$;

	NOTIFY pgrst, 'reload schema';
	"""}]

code: capabilities: hatches: billing: {
	kind: "container"
	note: "pronto-billing's service: publishes the plans, takes the broker's entitlements into the database, and sends an account to pay or to manage what it pays for"
}

// The door proxies to it on a host launch too: pronto runs the program's host peers
// (code.meta.hostPeers, pronto 0.24.1-gcp.26) beside its own renderer.
code: meta: hostPeers: billing: 8688

// The broker on this machine listens on a port of the app's own, hashed from its package as
// bayt hashes a launch's other ports (and pronto-identity its broker's), so two apps' launches
// never share it. billing_spec.cue names it as "http://localhost:28463", the address every
// spec was seeded with, or by its own address.
_billingLocalPort:   10000 + mod(strconv.ParseInt(strings.SliceRunes(hex.Encode(sha256.Sum256("pronto-billing/__PACKAGE__")), 0, 8), 16, 64), 22768)
_billingLocalBroker: "http://localhost:\(_billingLocalPort)"
_billingLocal:       _billing.broker == "http://localhost:28463" || _billing.broker == _billingLocalBroker
_billingBroker: [if _billingLocal {_billingLocalBroker}, _billing.broker][0]
_billingBrokerInternal: *_billingBroker | string
// The app's origin, as the renderer finds it: ORIGIN where a launch sets it, else the door as a
// person reaches it, the door's port the host projection gives BILLING_DOOR (caddy:8443).
_billingOrigin: "export ORIGIN=\"${ORIGIN:-https://localhost:${BILLING_DOOR##*:}}\"; "
if _billing.brokerInternal != _|_ {_billingBrokerInternal: _billing.brokerInternal}

cluster: surface: targets: billing: {
	srcs: globs: ["billing/*.ts", "billing/broker/*.ts"]
	expose: http: {port: 8688, env: "BILLING_PORT"}
	"process-compose": activate: "mise x --"
	entrypoint: {
		do:    "\(_billingOrigin)exec deno run --no-config --allow-net --allow-env billing/service.ts"
		shell: "sh"
		dockerfile: {do: "\(_billingOrigin)exec deno run --no-config --allow-net --allow-env /app/billing/service.ts", shell: "sh"}
		env: compose.environment
		after: {crud: "healthy", migrate: "completed"}
		if _billingLocal {after: "billing-broker": "healthy"}
	}
	dockerfile: {
		from: name: "denoland/deno:alpine-2.5.0"
		copy: [{srcs: ["billing/service.ts", "billing/entitlement.ts", "billing/shared.ts"], dst: "/app/billing/"}]
	}
	compose: {
		restart: "on-failure"
		environment: {
			BILLING_DOOR:            "caddy:8443"
			BILLING_BROKER:          _billingBroker
			BILLING_BROKER_INTERNAL: _billingBrokerInternal
			BILLING_DOCUMENT:        _billingDocument
			BILLING_GRANTS:          _billingGrants
			BILLING_FLAGS:           _billingFlags
			CRUD_URL:                "http://crud:3000"
			SERVICE_JWT:             "${SERVICE_JWT:-eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoic2VydmljZSIsInN1YiI6IjAwMDAwMDAwLTAwMDAtMDAwMC0wMDAwLTAwMDAwMDAwMDAwMCIsImV4cCI6MTk4ODE1MDQwMH0.dGYz_sMSnOvZy0eANh7spJbgyr2fEzeynOERIqW7gd4}"
		}
	}
}

// On a developer's machine, the broker itself, its Stripe a stand-in that
// pays at a press, and this app's payouts already set up.
if _billingLocal {
	cluster: surface: targets: "billing-broker": bayt.healthcheck.http & {
		cmd: builtin: null
		activate: ""
		srcs: globs: ["billing/*.ts", "billing/broker/*.ts"]
		healthcheck: url: "http://127.0.0.1:\(_billingLocalPort)/health"
		expose: http: port: _billingLocalPort
		"process-compose": activate: "mise x --"
		entrypoint: {
			// It pushes to the door, whose certificate is the developer's own.
			do:    "\(_billingOrigin)BILLING_FAKE_TENANTS=\"$ORIGIN\" exec deno run --no-config --allow-net --allow-env --unsafely-ignore-certificate-errors=localhost billing/broker/main.ts"
			shell: "sh"
			dockerfile: {do: "\(_billingOrigin)BILLING_FAKE_TENANTS=\"$ORIGIN\" exec deno run --no-config --allow-net --allow-env --unsafely-ignore-certificate-errors=localhost /app/billing/broker/main.ts", shell: "sh"}
			env: compose.environment
		}
		dockerfile: {
			from: name: "denoland/deno:alpine-2.5.0"
			copy: [
				{srcs: ["billing/shared.ts"], dst: "/app/billing/"},
				{srcs: ["billing/broker/core.ts", "billing/broker/main.ts", "billing/broker/stripe.ts", "billing/broker/fake.ts"], dst: "/app/billing/broker/"},
			]
		}
		compose: {
			ports: ["\(_billingLocalPort):\(_billingLocalPort)"]
			environment: {
				BROKER_ISSUER: _billingLocalBroker
				BROKER_SECRET: "pronto-billing-local-launch-secret-000000"
				BILLING_DOOR:  "caddy:8443"
				PORT:          "\(_billingLocalPort)"
			}
		}
	}
}
