// generated by pronto-journeys from journeys/host.cue — do not edit
package hello_journeys

import (
	"list"
	"strings"
)

// The terminal's reporter: a host-DOM hatch on every screen, reading
// the reader's gestures and the screen's state (telemetry.js).
code: capabilities: hatches: "journeys-telemetry": {
	kind:  "host-dom"
	src:   "shell/hatches/journeys/telemetry.js"
	files: ["shell/hatches/journeys/telemetry.js"]
	note:  "pronto-journeys' reporter: posts each gesture and its outcome, read from the screen's data-state, to /telemetry"
}
// Every screen gets the reporter. A screen with hatches of its own names
// the reporter among them, and the app lists it in _journeysOwnHatches
// so this does not; vet lists any screen left without it.
_journeysOwnHatches: *[] | [...string]
code: surface: screens: [!~"^(\(strings.Join(_journeysOwnHatches, "|")))$"]: hatches: ["journeys-telemetry"]
_journeysUnreported: [for n, s in code.surface.screens if !list.Contains(s.hatches, "journeys-telemetry") {n}] & []

code: capabilities: hatches: "journeys-collector": {
	kind: "container"
	note: "pronto-journeys' collector: Vector assembling the terminal's telemetry into journey runs"
}

cluster: surface: targets: "journeys-collector": {
	srcs: globs: ["observability/journeys.collector.yaml"]
	dockerfile: {
		from: name: "timberio/vector:0.43.0-alpine"
		copy: [{srcs: ["observability/journeys.collector.yaml"], dst: "/etc/vector/vector.yaml"}]
	}
	compose: restart: "on-failure"
}
