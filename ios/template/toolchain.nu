# generated by pronto-ios from ios/host.cue — do not edit
# The iOS host's verbs, which setup@ios, build@ios, test@ios and launch@ios run. Xcode is not a mise tool:
# it is the one on this Mac, found at DEVELOPER_DIR so that no `xcode-select -s` (sudo) is needed, and
# the version and the simulator runtime the host was written against are checked, with the exact version to
# install when they differ. xcodegen and swiftlint are mise's (.config/mise/conf.d/ios.toml).
use tools.nu [run-mise]

const developer_dir = "__DEVELOPER_DIR__"
const xcode = "__XCODE__"
const runtime = "__RUNTIME__"
const simulator = "__SIMULATOR__"
const bundle_id = "__BUNDLE_ID__"
const weight = __WEIGHT__

# The environment every Xcode tool runs in.
def xcode_env [] { {DEVELOPER_DIR: ($env.DEVELOPER_DIR? | default $developer_dir)} }

# Fails, saying what to install, when Xcode or the simulator runtime is not the one the host names.
export def check [] {
	with-env (xcode_env) {
		let found = (try { ^xcodebuild -version | lines | first } catch { "no Xcode" })
		if $found != $"Xcode ($xcode)" {
			print -e $"setup@ios: this host builds with Xcode ($xcode); found: ($found). Install Xcode ($xcode) at ($developer_dir | path dirname | path dirname)."
			exit 1
		}
		let runtimes = (^xcrun simctl list runtimes | complete | get stdout)
		if not ($runtimes | str contains $runtime) {
			print -e $"setup@ios: no simulator runtime ($runtime); install it with Xcode > Settings > Components."
			exit 1
		}
		let devices = (^xcrun simctl list devices available | complete | get stdout)
		if not ($devices | str contains $simulator) {
			print -e $"setup@ios: no simulator named ($simulator); create one with Xcode > Window > Devices and Simulators."
			exit 1
		}
		print $"ios: Xcode ($xcode), ($runtime), ($simulator)"
	}
}

# xcodegen writes ios/Host.xcodeproj, Info.plist and Host.entitlements from ios/project.yml.
def generate [] {
	run-mise exec -- xcodegen generate --spec ios/project.yml --project ios --quiet
}

# A heavy command under the machine's one budget (tests/slot.ts), with Xcode's environment.
def slotted [what: string, cmd: list<string>] {
	with-env (xcode_env) {
		run-mise exec -- deno run -A tests/slot.ts --weight $weight --what $what -- ...$cmd
	}
}

# SwiftLint reads Swift through Xcode's sourcekit, so it needs the same environment.
export def lint [] {
	with-env (xcode_env) { run-mise exec -- swiftlint lint --strict --config ios/.swiftlint.yml ios }
}

export def build [] {
	generate
	slotted ios-build [xcodebuild build -project ios/Host.xcodeproj -scheme Host -destination "generic/platform=iOS Simulator" -derivedDataPath ios/build -quiet]
}

export def test [] {
	generate
	slotted ios-test [xcodebuild test -project ios/Host.xcodeproj -scheme Host -destination $"platform=iOS Simulator,name=($simulator)" -derivedDataPath ios/build -quiet]
}

export def launch [] {
	build
	with-env (xcode_env) {
		# Booting a booted simulator is an error simctl reports and the launch does not mind.
		^xcrun simctl boot $simulator | complete | ignore
		^xcrun simctl bootstatus $simulator -b | ignore
		^xcrun simctl install $simulator ios/build/Build/Products/Debug-iphonesimulator/Host.app
		^xcrun simctl launch $simulator $bundle_id
	}
}
