# generated by pronto-ios from ios/host.cue — do not edit
# The iOS host's verbs, which setup@ios, build@ios, lint@ios, test@ios and launch@ios run. Xcode is not a mise tool:
# it is the one on this Mac, found at DEVELOPER_DIR so that no `xcode-select -s` (sudo) is needed, and
# the version and the simulator runtime the host was written against are checked, with the exact version to
# install when they differ. xcodegen and swiftlint are mise's (.config/mise/conf.d/ios.toml).
use tools.nu [run-mise]

const developer_dir = "__DEVELOPER_DIR__"
const xcode = "__XCODE__"
const runtime = "__RUNTIME__"
const simulator = "__SIMULATOR__"
const bundle_id = "__BUNDLE_ID__"
const weight = __WEIGHT__

# The Xcode every tool runs from: the caller's DEVELOPER_DIR, else the host's.
def xcode_dir [] { $env.DEVELOPER_DIR? | default $developer_dir }

# The environment every Xcode tool runs in.
def xcode_env [] { {DEVELOPER_DIR: (xcode_dir)} }

def fail [message: string] {
	print -e $"ios: ($message)"
	exit 1
}

# The UDID of the simulator named exactly `simulator` under the runtime named exactly `runtime`: a name that only
# begins with it (iPhone 17e for iPhone 17) is another device, and so is one under another iOS.
def device [] {
	let runtimes = (^xcrun simctl list runtimes available -j | from json | get runtimes | where name == $runtime | get identifier)
	if ($runtimes | is-empty) { fail $"no simulator runtime named ($runtime); install it with Xcode > Settings > Components." }
	let devices = (^xcrun simctl list devices available -j | from json | get devices)
	let found = ($runtimes | each {|id| $devices | get --optional $id | default [] } | flatten | where name == $simulator)
	if ($found | is-empty) { fail $"no simulator named ($simulator) under ($runtime); create one with Xcode > Window > Devices and Simulators." }
	$found | first | get udid
}

# Fails, saying what to install, when Xcode, the simulator runtime or the device is not the one the host names.
export def check [] {
	with-env (xcode_env) {
		let probe = (try { ^xcodebuild -version | complete } catch {|e| {exit_code: 127, stdout: "", stderr: $e.msg} })
		let found = ($probe.stdout | lines | get --optional 0 | default "")
		if $probe.exit_code != 0 or $found != $"Xcode ($xcode)" {
			let said = ($"($probe.stderr)" | str trim)
			let found_text = (if ($found | is-empty) { "no Xcode" } else { $found })
			let said_text = (if ($said | is-empty) { "" } else { $"(char nl)xcodebuild said: ($said)" })
			fail $"this host builds with Xcode ($xcode) at DEVELOPER_DIR=(xcode_dir); found: ($found_text). Install Xcode ($xcode), or point DEVELOPER_DIR at its Contents/Developer.($said_text)"
		}
		let udid = (device)
		print $"ios: Xcode ($xcode) at (xcode_dir), ($runtime), ($simulator) ($udid)"
	}
}

# xcodegen writes ios/Host.xcodeproj, Info.plist and Host.entitlements from ios/project.yml.
def generate [] {
	run-mise exec -- xcodegen generate --spec ios/project.yml --project ios --quiet
}

# A heavy command under the machine's one budget (tests/slot.ts), with Xcode's environment.
def slotted [what: string, cmd: list<string>] {
	with-env (xcode_env) {
		run-mise exec -- deno run -A tests/slot.ts --weight $weight --what $what -- ...$cmd
	}
}

# SwiftLint reads Swift through Xcode's sourcekit, so it needs the same environment.
export def lint [] {
	check
	with-env (xcode_env) { run-mise exec -- swiftlint lint --strict --config ios/.swiftlint.yml ios }
}

export def build [] {
	check
	generate
	slotted ios-build [xcodebuild build -project ios/Host.xcodeproj -scheme Host -destination "generic/platform=iOS Simulator" -derivedDataPath ios/build -quiet]
}

export def test [] {
	check
	generate
	with-env (xcode_env) {
		let udid = (device)
		slotted ios-test [xcodebuild test -project ios/Host.xcodeproj -scheme Host -destination $"id=($udid)" -derivedDataPath ios/build -quiet]
	}
}

export def launch [] {
	build
	with-env (xcode_env) {
		let udid = (device)
		# Booting a booted simulator is an error simctl reports and the launch does not mind.
		^xcrun simctl boot $udid | complete | ignore
		^xcrun simctl bootstatus $udid -b | ignore
		^xcrun simctl install $udid ios/build/Build/Products/Debug-iphonesimulator/Host.app
		^xcrun simctl launch $udid $bundle_id
	}
}
