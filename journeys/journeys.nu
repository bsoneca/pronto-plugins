# The journeys host's generate step, run by the rule pronto/journeys.cue adds,
# after pronto's writer. Written by pronto-journeys; regenerated, do not edit.

const header = "// generated by pronto-journeys from the screens' markup — do not edit\n"
const begin = "  # pronto-journeys:begin — the terminal's telemetry, to the journeys collector"
const end = "  # pronto-journeys:end"

# A file rewritten only when its text changes, so a generate that changes
# nothing leaves every watch and build cache where it was.
def save-changed [path: path] {
	let text = $in
	if not ($path | path exists) or (open --raw $path) != $text {
		mkdir ($path | path dirname)
		$text | save --force --raw $path
	}
}

# Each screen's gestures, from the markup pronto just emitted: a data-on-*
# handler for an event the terminal reports, by its module; a form by its id,
# else its action and entity joined by "-", else "form". The rule is the
# terminal's (omnishell's docs/telemetry.md); this reads it off the same files
# the terminal interprets, into journeys_gestures.cue.
export def derive [package: string, events: string] {
	let reader = $events | split row ","
	let gestures = open shell/shell.json | get routes | each {|route|
		let html = open --raw $route.files.html
		let handlers = $html
			| parse --regex 'data-on-(?<event>[a-z]+)="(?<name>[^"{}]+)"'
			| where event in $reader
			| get name
		let forms = $html | parse --regex '<form\b(?<attrs>[^>]*)>' | get attrs | each {|attrs|
			let attr = $attrs | parse --regex '(?:^|\s)(?<k>id|data-action|data-entity)="(?<v>[^"]*)"' | reduce --fold {} {|kv, acc| $acc | upsert $kv.k $kv.v }
			let named = [($attr | get --optional data-action) ($attr | get --optional data-entity)] | compact --empty | str join "-"
			[($attr | get --optional id) $named "form"] | compact --empty | first
		}
		{screen: $route.screen, names: ($handlers | append $forms)}
	} | reduce --fold {} {|it, acc| $acc | upsert $it.screen (($acc | get --optional $it.screen | default []) | append $it.names | uniq | sort)}
	$"($header)package ($package)\n\n_journeyGestures: ($gestures | to json --tabs 1)\n" | save-changed journeys_gestures.cue
}

# The door's route to the collector, which pronto's writer regenerates without
# it. An earlier run's goes first, so a changed endpoint replaces the old one.
export def route [endpoint: string] {
	# The collector listens on /telemetry alone, whatever the endpoint.
	let route = [
		$begin
		$"  handle ($endpoint) {"
		# A batch is a few kilobytes; anything far past that is no terminal's.
		"    request_body {"
		"      max_size 64KB"
		"    }"
		"    rewrite * /telemetry"
		# The host rewrites the upstream where the collector runs apart (a release's own Cloud Run
		# service, reached over HTTPS): the mesh name alone resolves only beside the door.
		"    reverse_proxy {$PRONTO_UPSTREAM_JOURNEYS_COLLECTOR:journeys-collector:8686} {"
		"      header_up dapr-app-id journeys-collector"
		"      header_up Host {upstream_hostport}"
		"    }"
		"  }"
		$end
	]
	let all = open --raw docker/Caddyfile | lines
	let from = $all | enumerate | where item == $begin | get index.0?
	let to = $all | enumerate | where item == $end | get index.0?
	let lines = if $from == null or $to == null { $all } else { [...($all | first $from) ...($all | skip ($to + 1))] }
	# Into the (app) snippet every listener imports, before its first route and
	# the comment that route carries.
	let at = $lines | enumerate | where {|l| $l.item | str starts-with "  handle /auth/*"} | get index.0?
	if $at == null { error make {msg: "docker/Caddyfile has no `handle /auth/*` to place the telemetry route before"} }
	let start = $at - ($lines | first $at | reverse | take while {|l| $l | str starts-with "  #"} | length)
	[...($lines | first $start) ...$route ...($lines | skip $start)] | str join "\n" | $"($in)\n" | save-changed docker/Caddyfile
}

# The program's `journeys.out`, as `cue export -e journeys.out --out json`
# gives it, into observability/: YAML or JSON by each name's extension.
export def write [] {
	let out = $in | from json
	for f in ($out | columns) {
		let value = $out | get $f
		(if ($f | str ends-with ".yaml") { $value | to yaml } else { $value | to json --indent 2 }) | save-changed $"observability/($f)"
	}
}

# The collector and the local dashboard beside it, on the app's network: what
# `sayt launch@journeys` runs after `sayt launch`. Prints where to look.
export def up [] {
	^docker compose --profile journeys-collector up --detach --build journeys-collector
	let collector = ^docker compose --profile journeys-collector ps --quiet journeys-collector | str trim
	let network = ^docker inspect $collector | from json | get 0.NetworkSettings.Networks | columns | first
	let dashboard = (dashboard-env $network)
	with-env $dashboard { ^docker compose --file journeys/dashboard.compose.yaml up --detach --force-recreate }
	let door = ^docker compose ps --format json | lines | each { from json } | get Publishers | flatten
		| where TargetPort == 8443 and PublishedPort > 0 | get PublishedPort.0?
	let port = {|service, inner| with-env $dashboard { ^docker compose --file journeys/dashboard.compose.yaml port $service $inner } | str trim | split row ":" | last }
	print ""
	if $door != null { print $"  app        https://localhost:($door)" } else { print "  app        (run `sayt launch` first: no door is up)" }
	print $"  dashboard  http://localhost:(do $port grafana 3000)"
	print $"  alerts     http://localhost:(do $port vmalert 8880)/vmalert/groups"
}

# Stops the local dashboard and the collector; `sayt launch`'s stack is left.
export def down [] {
	with-env (dashboard-env "none") { ^docker compose --file journeys/dashboard.compose.yaml down }
	^docker compose --profile journeys-collector stop journeys-collector
}

def dashboard-env [network: string] {
	{JOURNEYS_NETWORK: $network, JOURNEYS_PROJECT: $"($env.PWD | path basename | str downcase | str replace --all --regex '[^a-z0-9_-]' '-')-journeys"}
}
