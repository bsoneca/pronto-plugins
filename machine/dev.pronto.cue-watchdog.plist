<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>dev.pronto.cue-watchdog</string>
  <key>ProgramArguments</key>
  <array><string>/bin/bash</string><string>__DIR__/watchdog.sh</string></array>
  <key>StartInterval</key><integer>10</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/pronto/cue-watchdog.out</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/pronto/cue-watchdog.out</string>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>/usr/bin:/bin:/usr/sbin:/sbin</string></dict>
</dict>
</plist>
