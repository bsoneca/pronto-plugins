<?xml version="1.0" encoding="utf-8"?>
<!-- No backup: the device tables are sealed under a Keystore key that never
     leaves this phone, so a restored copy could never be opened. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- An app login is pinned to its app's signing certificate, so the host
         reads the certificates of the apps a person can open. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>
    <application
        android:label="__LABEL__"
        android:allowBackup="false"
        android:theme="@style/Theme.AppCompat.DayNight.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".FillActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.Pronto.Fill" />
        <service
            android:name=".FillService"
            android:exported="true"
            android:label="__LABEL__"
            android:permission="android.permission.BIND_AUTOFILL_SERVICE">
            <intent-filter>
                <action android:name="android.service.autofill.AutofillService" />
            </intent-filter>
            <meta-data
                android:name="android.autofill"
                android:resource="@xml/autofill_service" />
        </service>
    </application>
</manifest>
