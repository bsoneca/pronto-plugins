// generated by pronto-flags from flags/app/ — do not edit
package __PACKAGE__

import (
	"encoding/json"
	"strings"
)

// Feature flags (pronto-flags): values the app reads while it runs, each with
// one value wherever it is released and, where it says, another wherever it
// runs at hand (a developer's launch, CI) and for the accounts it names.
// flags_spec.cue says them; flagd, OpenFeature's flag daemon, serves them
// beside the door over OpenFeature's remote evaluation protocol (OFREP), at
// /ofrep/ on the app's own origin. Where the app is released, flagd reads them
// live from a Cloud Storage object (flagsLive), so a flag changes with
// `pronto-flags push`, never a deploy.
#Flag: {
	// What the flag turns on or off, and why it is a flag.
	note?: string
	// Its value wherever the app is released.
	default!: bool | string | number
	// Its value wherever the door is reached at hand: localhost, 127.0.0.1,
	// or compose's `caddy`, as CI's checks reach it, and for `accounts`. Of
	// the default's kind.
	local?: bool | string | number
	if (default & bool) != _|_ {local?: bool}
	if (default & string) != _|_ {local?: string}
	if (default & number) != _|_ {local?: number}
	// The accounts that read `local` wherever the app runs: their ids, the
	// `sub` of their session's token, which the door reads from the verified
	// session (the auth service's /auth/door) and hands flagd as the
	// targetingKey, over any a page sent. A page with no session is no account,
	// but a flag still opens a feature and never guards it: what an account
	// may do stays the database's.
	accounts?: [...string & =~"^[A-Za-z0-9_-]{1,64}$"]
}
#Flags: [=~"^[a-z][a-z0-9_-]{0,63}$"]: #Flag
flags: #Flags

// The hosts a door answers at hand. The door, not the page, says which host a
// request reached and which account it is from (flagd's --context-from-header,
// over a targetingKey in the body): a page cannot claim either.
_flagsLocal: ["localhost", "127.0.0.1", "caddy"]

// flagd's flag definitions (https://flagd.dev/reference/flag-definitions/),
// which generate writes to flags/flags.json for the flagd image to carry.
flagd: document: {
	"$schema": "https://flagd.dev/schema/v0/flags.json"
	"flags": {
		for k, f in flags {
			"\(k)": {
				state: "ENABLED"
				variants: {
					default: f.default
					if f.local != _|_ {local: f.local}
					// The value a flag's accounts read: no accounts without one.
					if f.accounts != _|_ {local: f.local}
				}
				defaultVariant: "default"
				if f.local != _|_ && f.accounts == _|_ {
					targeting: {"if": [{"in": [{"var": "host"}, _flagsLocal]}, "local", "default"]}
				}
				if f.local != _|_ && f.accounts != _|_ {
					targeting: {"if": [{"in": [{"var": "host"}, _flagsLocal]}, "local", {"in": [{"var": "targetingKey"}, f.accounts]}, "local", "default"]}
				}
			}
		}
	}
}

// The flags in the app's database too, for what the database decides by them (a feature's writes
// refused while its flag is off): generate writes this to flags/flags.sql, which an app with a database
// lists among its raw migrations, so every release replays it. It adds only. pronto_flags.flag_on(flag,
// player) reads the flag the way flagd answers it, from the document `pronto-flags push` wrote there
// (flagsLive.database) and the host that document is served at: its default, its local value at hand,
// and its accounts. A flag the document lacks, or no document, is off.
// A test database (one holding the marker pronto_flags.at_hand, which only the app's fixture inserts)
// holds the flags baked into the image instead, at hand's host, refreshed at every replay.
flagd: sql: """
	-- pronto-flags: the app's flags in its database (flags_plugin.cue's flagd.sql). Generated, do not edit.
	SET lock_timeout = '30s';
	SET statement_timeout = '60s';
	CREATE SCHEMA IF NOT EXISTS pronto_flags;
	GRANT USAGE ON SCHEMA pronto_flags TO PUBLIC;
	-- The document flagd serves, and the host it is evaluated for: one row, written by put() alone.
	CREATE TABLE IF NOT EXISTS pronto_flags.live (
	  one boolean PRIMARY KEY DEFAULT true CHECK (one),
	  doc jsonb NOT NULL,
	  host text NOT NULL,
	  at timestamptz NOT NULL DEFAULT now()
	);
	-- A test database's marker, which only the app's fixture inserts: a release's database never has it.
	CREATE TABLE IF NOT EXISTS pronto_flags.at_hand (one boolean PRIMARY KEY DEFAULT true CHECK (one));
	REVOKE ALL ON pronto_flags.live, pronto_flags.at_hand FROM PUBLIC;

	-- JSON Logic's truth: false, null, 0, "" and [] are false.
	CREATE OR REPLACE FUNCTION pronto_flags.truthy(v jsonb) RETURNS boolean LANGUAGE sql IMMUTABLE AS $f$
	  SELECT v IS NOT NULL AND v NOT IN ('null'::jsonb, 'false'::jsonb, '0'::jsonb, '""'::jsonb, '[]'::jsonb)
	$f$;

	-- The part of flagd's targeting (JSON Logic) the flags plugin writes: if, in and var. Any other
	-- operator raises, and the flag reads its default variant, as flagd's does on a rule it cannot evaluate.
	CREATE OR REPLACE FUNCTION pronto_flags.rule(r jsonb, ctx jsonb) RETURNS jsonb LANGUAGE plpgsql IMMUTABLE AS $f$
	DECLARE op text; args jsonb; n int; i int := 0; v jsonb; within jsonb;
	BEGIN
	  IF r IS NULL OR jsonb_typeof(r) <> 'object' THEN RETURN r; END IF;
	  IF (SELECT count(*) FROM jsonb_object_keys(r)) <> 1 THEN RAISE EXCEPTION 'pronto_flags: a rule names one operator: %', r; END IF;
	  SELECT k INTO op FROM jsonb_object_keys(r) k;
	  args := r -> op;
	  IF op = 'var' THEN
	    IF jsonb_typeof(args) = 'array' THEN args := args -> 0; END IF;
	    RETURN ctx #> string_to_array(args #>> '{}', '.');
	  END IF;
	  IF jsonb_typeof(args) <> 'array' THEN args := jsonb_build_array(args); END IF;
	  n := jsonb_array_length(args);
	  IF op = 'if' THEN
	    WHILE i + 1 < n LOOP
	      IF pronto_flags.truthy(pronto_flags.rule(args -> i, ctx)) THEN RETURN pronto_flags.rule(args -> (i + 1), ctx); END IF;
	      i := i + 2;
	    END LOOP;
	    IF i < n THEN RETURN pronto_flags.rule(args -> i, ctx); END IF;
	    RETURN NULL;
	  ELSIF op = 'in' THEN
	    v := pronto_flags.rule(args -> 0, ctx);
	    within := pronto_flags.rule(args -> 1, ctx);
	    IF v IS NULL OR v = 'null'::jsonb THEN RETURN 'false'::jsonb; END IF;
	    IF jsonb_typeof(within) = 'array' THEN RETURN to_jsonb(within @> jsonb_build_array(v)); END IF;
	    IF jsonb_typeof(within) = 'string' AND jsonb_typeof(v) = 'string' THEN RETURN to_jsonb(strpos(within #>> '{}', v #>> '{}') > 0); END IF;
	    RETURN 'false'::jsonb;
	  END IF;
	  RAISE EXCEPTION 'pronto_flags: no operator % in this evaluator', op;
	END $f$;

	-- A flag's value for a player (null: no one), as flagd answers it; null where the document has no such flag,
	-- or the flag is disabled, or there is no document.
	CREATE OR REPLACE FUNCTION pronto_flags.flag_value(flag text, player uuid DEFAULT NULL) RETURNS jsonb
	LANGUAGE plpgsql STABLE SECURITY DEFINER SET search_path = pg_catalog AS $f$
	DECLARE d jsonb; h text; f jsonb; v jsonb;
	BEGIN
	  SELECT l.doc, l.host INTO d, h FROM pronto_flags.live l;
	  f := d -> 'flags' -> flag;
	  IF f IS NULL OR coalesce(f ->> 'state', 'ENABLED') <> 'ENABLED' THEN RETURN NULL; END IF;
	  v := NULL;
	  IF f ? 'targeting' AND f -> 'targeting' <> '{}'::jsonb THEN
	    BEGIN
	      v := pronto_flags.rule(f -> 'targeting', jsonb_build_object('host', h, 'targetingKey', player::text,
	        '$flagd', jsonb_build_object('flagKey', flag, 'timestamp', floor(extract(epoch FROM now()))::bigint)));
	    EXCEPTION WHEN OTHERS THEN v := NULL;
	    END;
	  END IF;
	  IF v IS NULL OR v = 'null'::jsonb OR NOT (f -> 'variants') ? (v #>> '{}') THEN v := f -> 'defaultVariant'; END IF;
	  RETURN f -> 'variants' -> (v #>> '{}');
	END $f$;

	-- Whether a boolean flag is on for a player: off for a flag the document lacks, or no document.
	CREATE OR REPLACE FUNCTION pronto_flags.flag_on(flag text, player uuid DEFAULT NULL) RETURNS boolean
	LANGUAGE sql STABLE AS $f$
	  SELECT coalesce(pronto_flags.flag_value(flag, player) = 'true'::jsonb, false)
	$f$;

	-- Written by `pronto-flags push`, its restore and rollback (flagsLive.database), and by fill_local().
	CREATE OR REPLACE FUNCTION pronto_flags.put(doc jsonb, host text) RETURNS void
	LANGUAGE sql SECURITY DEFINER SET search_path = pg_catalog AS $f$
	  INSERT INTO pronto_flags.live (one, doc, host, at) VALUES (true, doc, host, now())
	  ON CONFLICT (one) DO UPDATE SET doc = excluded.doc, host = excluded.host, at = excluded.at
	$f$;
	REVOKE EXECUTE ON FUNCTION pronto_flags.put(jsonb, text) FROM PUBLIC;

	-- A test database holds the flags baked into the image, at hand's host; any other database, nothing here.
	CREATE OR REPLACE FUNCTION pronto_flags.fill_local() RETURNS void
	LANGUAGE plpgsql SECURITY DEFINER SET search_path = pg_catalog AS $f$
	BEGIN
	  IF EXISTS (SELECT 1 FROM pronto_flags.at_hand) THEN
	    PERFORM pronto_flags.put('\(_flagsDocQuoted)'::jsonb, '\(_flagsLocal[0])');
	  END IF;
	END $f$;
	REVOKE EXECUTE ON FUNCTION pronto_flags.fill_local() FROM PUBLIC;
	SELECT pronto_flags.fill_local();

	"""
// The document as an SQL string literal's body: its quotes doubled.
_flagsDocQuoted: strings.Replace(json.Marshal(flagd.document), "'", "''", -1)

// flagd's ports, clear of pronto-perf's 8687, pronto-billing's 8688 and the
// 8689 an app may hold for a service of its own: OFREP, the one the door proxies to, then
// evaluation, management and sync, all of them held in an instance whose
// containers share one network.
_flagdPorts: {ofrep: 8693, evaluation: 8694, management: 8695, sync: 8696}
// The flags baked into the image, which flagd serves until a later source
// says otherwise: where the app is released, the live object flagsLive names,
// given as FLAGD_SOURCES (flagd reads its options from FLAGD_* too, and a
// source there overrides the file's flags). No SSE stream held open: a page
// asks once, and reads a change on its next load. On a host launch the OFREP
// port is the one the launch hands out (FLAGD_OFREP_PORT), which the door's
// peer address names.
#FlagdArgs: {
	file: string
	ofrep: *"--ofrep-port \(_flagdPorts.ofrep) " | ""
	// On a host launch these are the ports it hands out (FLAGD_PORT, FLAGD_MANAGEMENT_PORT,
	// FLAGD_SYNC_PORT, which flagd reads), so stacks side by side never share them.
	ports: *"--port \(_flagdPorts.evaluation) --management-port \(_flagdPorts.management) --sync-port \(_flagdPorts.sync) " | ""
	out:  "start --uri file:\(file) \(ofrep)\(ports)--ofrep-sse-enabled=false --context-from-header X-Pronto-Host=host --context-from-header X-Pronto-Account=targetingKey"
}

// Where the released app's flags live: one object in a Cloud Storage bucket
// with versioning, whose versions are the flags' history and their rollback
// (`pronto-flags setup`, `push`, `history`, `rollback`). flags_spec.cue names
// the bucket and the project that holds it; release.cue hands flagd the source,
// spelled out (`sidecars: flagd: env: FLAGD_SOURCES: "<flagsLive.sources>"`),
// since a release reads that file alone, and flags_spec.cue holds the two to
// each other.
flagsLive?: {
	// A bucket (with its project), or a local directory instead (`dir`, relative to the app's
	// folder or absolute): the same versioned store kept as files, `<dir>/flags.json` live and
	// `<dir>/versions/` the rest, which flagd reads as a file source. For a drill, a laptop or a test.
	project?: =~"^[a-z][a-z0-9-]{4,28}[a-z0-9]$"
	bucket?:  =~"^[a-z0-9][a-z0-9_.-]{1,61}[a-z0-9]$"
	dir?:     string & !=""
	object:   *"flags.json" | =~"^[A-Za-z0-9_./-]+\\.json$"
	if bucket != _|_ {
		sources: "[{\"uri\":\"gs://\(bucket)/\(object)\",\"provider\":\"gcs\"}]"
	}
	if dir != _|_ {
		sources: "[{\"uri\":\"\(dir)/flags.json\",\"provider\":\"file\"}]"
	}
	// Production's address, where a flip's live cases run (`flagsCases.live`) once `push` has
	// written the flags for everyone and OFREP answers their new value.
	url?: =~"^https://[a-z0-9][a-z0-9.-]*[a-z0-9](:[0-9]+)?$"
	// No longer read (PRONTO-284, 2026-11-11: a flip has no testers' stage; the owner: "drop the
	// requirement of testers for flag flips"). Kept so an app that still says them evaluates.
	testers?: [...string & =~"^[A-Za-z0-9_-]{1,64}$"]
	runAs?:   string
	alert?:   string
	// The app's command that runs SQL (on its stdin) in the released app's database, as the database's owner:
	// each write of the object (push, its restore, rollback) is written there too, through
	// pronto_flags.put() (flagd.sql), for pronto_flags.flag_on(). A write that fails there fails the push.
	database?: string & !=""
	// Where else a flagd reads the flags: a release@k8s node's ConfigMap, which its flagd mounts
	// (release.cue's services.flagd.files) and reads as a file source. Each write of the object
	// (push, its restore, rollback) is applied there too, over ssh, as the node's kubectl.
	// A mirror that fails warns, so a staging node never holds a flip back; a required one (the
	// node is production) fails the push.
	mirrors: [...{
		ssh!:       =~"^[a-z_][a-z0-9_-]*@[A-Za-z0-9.-]+$"
		namespace!: =~"^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
		configMap!: =~"^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
		key:        *"flags.json" | =~"^[A-Za-z0-9_.-]+$"
		kubectl:    *"sudo k3s kubectl" | string
		required:   *false | bool
	}]
}

// The app's command for a flip's cases (`pronto-flags push`), run with `sh -c` in the app's
// folder. A flip runs its cases on production, and nothing at hand (it builds no stack): `live`
// runs once the flag is on for everyone, with env `FLAG`, `ONLY` (the flag's scenarios marked
// `production` that sign in as no one: no `signIn` step) and `APP_URL` (flagsLive.url), and
// fails with a non-zero exit, which writes the version before the flip again. A flag's
// cases are the scenarios (tests/scenarios/*.cue) and unit cases (tests/unit/*.cue) that name
// it in `flags`, or in a step's `flag`; `pronto-flags cases <app-dir> [flag]` lists them.
#FlagsCases: {
	live?: string
}
flagsCases?: #FlagsCases

code: capabilities: hatches: flagd: {
	kind: "container"
	note: "pronto-flags' flagd: evaluates the app's feature flags (flags_spec.cue) over OFREP, behind the door's /ofrep/"
}

// The door proxies to it by its peer address: where a launch hands flagd its OFREP port
// (mecha 0.22's host launch moves it), the door's variable follows.
cluster: surface: targets: caddy: entrypoint: env: PRONTO_UPSTREAM_FLAGD: {peer: "flagd", port: "http"}

cluster: surface: targets: flagd: {
	srcs: globs: ["flags/flags.json"]
	expose: {
		http:       {port: _flagdPorts.ofrep, env: "FLAGD_OFREP_PORT"}
		eval:       {port: _flagdPorts.evaluation, env: "FLAGD_PORT"}
		management: {port: _flagdPorts.management, env: "FLAGD_MANAGEMENT_PORT"}
		sync:       {port: _flagdPorts.sync, env: "FLAGD_SYNC_PORT"}
	}
	"process-compose": activate: "mise x --"
	entrypoint: {
		do:    "exec flagd \((#FlagdArgs & {file: "flags/flags.json", ofrep: "", ports: ""}).out)"
		shell: "sh"
		// The image's binary, distroless: no shell to run it with.
		dockerfile: {do: "/flagd-build \((#FlagdArgs & {file: "/flags/flags.json"}).out)", shell: "exec"}
	}
	dockerfile: {
		from: name: "ghcr.io/open-feature/flagd:\(#FlagdVersion)"
		copy: [{srcs: ["flags/flags.json"], dst: "/flags/"}]
	}
	compose: restart: "on-failure"
}

#FlagdVersion: "v0.18.0"
