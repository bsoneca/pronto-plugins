// The perf host: how a pronto app runs on its readers' devices, on unmodified
// pronto. A host-DOM hatch on every screen measures frames, long animation
// frames, interactions, paint, layout shift and lost WebGL contexts, whatever
// draws the page; a collector turns its reports into metrics, burned against
// the app's SLOs by vmalert rules and drawn by a Grafana dashboard, all
// generated from one spec.
//
// pronto has no perf, so the host holds generated files, as the journeys host
// does: a seat beside pronto/config.cue's, the schema in the app's own package,
// and the step its generate runs after pronto's writer.
@extern(embed)

package perf

import (
	"encoding/json"
	"strings"
)

_schema: _ @embed(file="schema.cue", type=text)
_perfNu: _ @embed(file="perf.nu", type=text)
_perfJs: _ @embed(file="perf.js", type=text)

_reporterPath: "shell/hatches/perf/perf.js"
_configPath:   "shell/hatches/perf/config.js"

#Tools: {
	// promtool lints the rules; Vector runs the collector on a host and its
	// unit tests (the perf checks).
	"github:prometheus/prometheus": "v3.5.0"
	"aqua:vectordotdev/vector":     #PerfVectorVersion
}

#Host: H={
	// The program's CUE package, which the schema joins.
	package!: =~"^[a-z][a-z0-9_]*$"
	// Where the reporter posts and the door routes: same-origin, since the
	// terminal's policy is connect-src 'self'.
	endpoint: *"/perf" | =~"^/[a-z0-9/_-]+$"

	_header: "// generated by pronto-perf from perf/host.cue — do not edit\n"
	_step:   "use ./perf/perf.nu"

	// The generate rule, after pronto's writer (priority 1): the door it just
	// rewrote is given the route again, and the program's `perf` is exported
	// into observability/ and the reporter's settings.
	_generate: {
		priority: 2
		cmds: [{do: "use tools.nu [run-mise]; \(H._step); perf route \(H.endpoint); run-mise exec -- cue export . -e perf.out --out json | perf write"}]
	}

	files: {
		"pronto/perf.cue": {
			seed: false
			text: H._header + """
				package prontoproject

				pronto: {
					tools: \(json.Marshal(#Tools))
					say: say: generate: rulemap: perf: \(json.Marshal(H._generate))
				}

				"""
		}
		"perf_plugin.cue": {
			seed: false
			text: H._header + strings.Replace(_schema, "\npackage perf\n", "\npackage \(H.package)\n", 1)
		}
		// The app's own: its SLOs and sample, and the checks.
		// Not perf.cue: sayt's lint vets an X.cue against a path X, and perf/ is
		// this host's.
		"perf_spec.cue": {
			seed: true
			text: """
				package \(H.package)

				// How this app promises to run: the share of frames drawn under a
				// budget, of interactions answered under one, and of sessions that
				// lose no WebGL context; `null` drops one. `sample` is the share of
				// sessions that report.
				//
				//	perf: #Perf & {slo: frames: {percent: 95, under: "33ms"}, sample: 0.25}
				perf: #Perf & {}

				loop: surface: checks: perf.checks

				"""
		}
		"perf/perf.nu": {seed: false, text: _perfNu}
		(_reporterPath): {seed: false, text: strings.Replace(_perfJs, "__ENDPOINT__", H.endpoint, 1)}
		// Until the first generate writes the app's, the defaults.
		(_configPath): {
			seed: true
			text: "// generated by pronto-perf from the app's perf_spec.cue — do not edit\nexport default \(json.Marshal((#Perf & {}).reporter));\n"
		}
		"perf_hatch.cue": {
			seed: false
			text: H._header + """
				package \(H.package)

				import (
					"list"
					"strings"
				)

				// The reporter: a host-DOM hatch on every screen (perf.js).
				code: capabilities: hatches: perf: {
					kind:  "host-dom"
					src:   "\(_reporterPath)"
					files: ["\(_reporterPath)", "\(_configPath)"]
					note:  "pronto-perf's reporter: frame times, long animation frames, interactions, paint, layout shift and lost WebGL contexts, bucketed and posted to \(H.endpoint)"
				}
				// Every screen gets the reporter. A screen with hatches of its own names
				// it among them, and the app lists the screen in _perfOwnHatches so this
				// does not; vet lists any screen left without it.
				_perfOwnHatches: *[] | [...string]
				code: surface: screens: [!~"^(\\(strings.Join(_perfOwnHatches, "|")))$"]: hatches: ["perf"]
				_perfUnreported: [for n, s in code.surface.screens if !list.Contains(s.hatches, "perf") {n}] & []

				code: capabilities: hatches: "perf-collector": {
					kind: "container"
					note: "pronto-perf's collector: Vector turning the reporter's batches into metrics"
				}

				// The door proxies to it on a host launch too: pronto runs the
				// program's host peers (code.meta.hostPeers, pronto 0.24.1-gcp.26)
				// beside its own renderer.
				code: meta: hostPeers: "perf-collector": 8687
				cluster: surface: targets: "perf-collector": {
					srcs: globs: ["observability/perf.collector.yaml", "perf/perf.nu"]
					expose: {
						http: {port: 8687, env: "PERF_HTTP_PORT"}
						metrics: {port: 9599, env: "PERF_METRICS_PORT"}
					}
					"process-compose": activate: "mise x --"
					entrypoint: {
						do:    "exec nu -c 'use perf/perf.nu; perf collect'"
						shell: "sh"
						dockerfile: {do: "vector --config /etc/vector/vector.yaml", shell: "exec"}
					}
					dockerfile: {
						from: name: "\(#PerfVector)"
						copy: [{srcs: ["observability/perf.collector.yaml"], dst: "/etc/vector/vector.yaml"}]
					}
					compose: restart: "on-failure"
				}

				"""
		}
	}
}
