// The errors host: what an app's pages throw, reported to the operator's GlitchTip. The app
// declares its project (errors_spec.cue); the host derives the reporter, the door's route to
// GlitchTip's ingest, and a stand-in for it on a host launch. Where GlitchTip runs is the
// operator's (errors/metal.nu); this host writes what the app owns.
//
// pronto has no errors, so the host holds generated files, as the analytics host does: a seat
// beside pronto/config.cue's, the schema in the app's own package, and the steps its generate runs
// around pronto's writer.
@extern(embed)

package errors

import (
	"encoding/json"
	"strings"

	"github.com/bsoneca/pronto-plugins/common"
)

_schema:    _ @embed(file="schema.cue", type=text)
_errorsNu:  _ @embed(file="errors.nu", type=text)
_reporter:  _ @embed(file="errors.js", type=text)
_standinTs: _ @embed(file="standin.ts", type=text)

// The stand-in's port on a host launch is one the launch hands it (ERRORS_PORT), and the door
// reaches it by its peer address (PRONTO_UPSTREAM_ERRORS); 8700 is its port in a container.
_reporterPath: "shell/hatches/errors/errors.js"
_configPath:   "shell/hatches/errors/config.js"

#Host: H={
	// The program's CUE package, which the schema joins.
	package!: =~"^[a-z][a-z0-9_]*$"

	_header: "// generated by pronto-errors from errors/host.cue — do not edit\n"
	_step:   "use ./errors/errors.nu"

	// The generate rules. The reporter's settings are written before pronto's writer (1) but after
	// every writer of what the program embeds (-1: a modular app's join/*.json, the spec's files),
	// since they are an export of the program itself (0, as flags' SQL is); the door's route after
	// pronto's writer (3), which regenerates the door without it.
	_write: {
		priority: 0
		cmds: [{do: "use tools.nu [run-mise]; \(H._step); run-mise exec -- cue export . -e errors.out --out json | errors write"}]
	}
	_route: {
		priority: 3
		cmds: [{do: "\(H._step); use ./pronto/exports.nu; let e = (exports of errors | from json); errors route $e.prefix $e.upstream"}]
	}

	files: {
		"pronto/errors.cue": {
			seed: false
			text: H._header + """
				package prontoproject

				pronto: say: say: generate: rulemap: {
					"errors-write": \(json.Marshal(H._write))
					"errors-route": \(json.Marshal(H._route))
				}

				"""
		}
		"errors_plugin.cue": {
			seed: false
			text: H._header + strings.Replace(_schema, "\npackage errors\n", "\npackage \(H.package)\n", 1)
		}
		// The app's own: its GlitchTip project. Not errors.cue: sayt's lint vets an X.cue against a
		// path X, and errors/ is this host's.
		"errors_spec.cue": {
			seed: true
			text: """
				package \(H.package)

				// Where this app's pages report what they throw (pronto-errors): the project and the public
				// key `bin/pronto-errors metal` printed for it, and GlitchTip's address. Until the project and
				// the key are written the reporter does nothing, and it reports only while the flag
				// `error_tracking` (flags_spec.cue) is on.
				//
				//	errors: #Errors & {project: 1, key: "<32 hex digits>", upstream: "https://errors.example.com"}
				errors: #Errors

				"""
		}
		"errors/errors.nu": {seed: false, text: _errorsNu}
		"pronto/exports.nu": {seed: false, text: common.exportsNu}
		"errors/standin.ts": {seed: false, text: _standinTs}
		(_reporterPath): {seed: false, text: _reporter}
		(_configPath): {
			seed: true
			text: "// generated by pronto-errors from the app's errors_spec.cue — do not edit\nexport default \(json.Marshal({project: 0, key: "", prefix: "/e", flag: "error_tracking"}));\n"
		}
		"errors_hatch.cue": {
			seed: false
			text: H._header + """
				package \(H.package)

				import (
					"list"
					"strings"
				)

				// The reporter: a host-DOM hatch on every screen (errors.js). A screen with hatches of its
				// own names it among them, and the app lists the screen in _errorsOwnHatches so this does
				// not; vet lists any screen left without it.
				code: capabilities: hatches: errors: {
					kind:  "host-dom"
					src:   "\(_reporterPath)"
					files: ["\(_reporterPath)", "\(_configPath)"]
					note:  "pronto-errors' reporter: sends what the page throws to GlitchTip through the door, while the flag is on"
				}
				_errorsOwnHatches: *[] | [...string]
				code: surface: screens: [!~"^(\\(strings.Join(_errorsOwnHatches, "|")))$"]: hatches: ["errors"]
				_errorsUnloaded: [for n, s in code.surface.screens if !list.Contains(s.hatches, "errors") {n}] & []

				code: capabilities: hatches: "errors-glitchtip": {
					kind: "container"
					note: "a stand-in for GlitchTip's ingest on a host launch: keeps the reports in memory, GET /events says them"
				}

				// The door proxies the reports to it on a host launch too, by its peer address: the port a
				// launch hands the stand-in (its `http`).
				cluster: surface: targets: caddy: entrypoint: env: PRONTO_UPSTREAM_ERRORS: {peer: "errors", port: "http"}
				cluster: surface: targets: errors: {
					srcs: globs: ["errors/standin.ts"]
					expose: http: {port: 8700, env: "ERRORS_PORT"}
					activate: ""
					"process-compose": activate: "mise x --"
					entrypoint: {
						do:    "exec deno run --no-config --allow-net --allow-env errors/standin.ts"
						shell: "sh"
						dockerfile: {do: "deno run --no-config --allow-net --allow-env /app/errors/standin.ts", shell: "exec"}
					}
					dockerfile: {
						from: name: "denoland/deno:alpine-2.5.0"
						copy: [{srcs: ["errors/standin.ts"], dst: "/app/errors/"}]
					}
					compose: restart: "on-failure"
				}

				"""
		}
	}
}
