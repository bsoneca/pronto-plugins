// generated by pronto-ads from ads/app/ads_plugin.cue — do not edit
// Google's rewarded ads (H5 Games Ads) in a document of their own. The game's page never loads a
// Google script: it frames the ad document, which an `ads` service answers at an origin of its own
// (adsense.frame), and the two talk by postMessage (ads.js, and the bridge below). The document, the
// bridge, the policy that holds the document and its hash are all written here once; `generate`
// writes them to ads/break.json, which ads/server.ts serves, and the origins to ads_site.js, which
// the page's module reads.
//
// This file is written into the app's own package (ads_plugin.cue), so every name here is
// prefixed: it sits beside the program's.
package __PACKAGE__

import (
	"crypto/sha256"
	"encoding/base64"
	"list"
	"strings"
)

// What Google's ads need, once, as the measured run of the ad document found them (a spike under
// this policy: no violation, and an ad started). A script source is a path, never a whole host:
// Google's host-wide JSONP (googleadservices.com, *.doubleclick.net) must never be one, and a
// path stops counting once a request is redirected, so none is wider than it has to be.
_adsGoogle: {
	// adsbygoogle.js and the implementation scripts it loads, and the traffic-quality script.
	script: ["https://pagead2.googlesyndication.com/pagead/", "https://ep2.adtrafficquality.google/sodar/"]
	// The ad's own frames, and the traffic-quality and sign frames Google makes of its own.
	frame: ["https://googleads.g.doubleclick.net", "https://ep2.adtrafficquality.google", "https://www.google.com"]
	connect: ["https://pagead2.googlesyndication.com", "https://ep1.adtrafficquality.google"]
	img: ["data:", "https://pagead2.googlesyndication.com", "https://googleads.g.doubleclick.net", "https://ep1.adtrafficquality.google", "https://www.google.com"]
	library: "\(script[0])js/adsbygoogle.js"
}

// The port the ad service listens on.
_adsPort: 8700

// The bridge: the one script of the ad document, inline, and held by its hash. It loads Google's
// library, and speaks only with the game's page: it answers a message only from `site`, sent by
// its parent, and tells only `site`. Version 1 of the contract (ads/README.md): the page sends
// {type, v, op: "break", id, name} and then {op: "show", id}; the bridge sends {id: null, event:
// "ready"} once Google's library is up, and {id, event} for the break in flight, `done` carrying
// Google's breakStatus.
_adsBridge: strings.TrimSpace("""
	(function () {
	  var SITE = "\(adsense.site)", CLIENT = "ca-\(adsense.publisher)", TYPE = "pronto-ads";
	  var test = new URLSearchParams(location.search).get("test") === "on";
	  var current = null, show = null;
	  var send = function (m) { m.type = TYPE; m.v = 1; parent.postMessage(m, SITE); };
	  window.adsbygoogle = window.adsbygoogle || [];
	  var adConfig = function (o) { window.adsbygoogle.push(o); };
	  var s = document.createElement("script");
	  s.async = true;
	  s.crossOrigin = "anonymous";
	  s.src = "\(_adsGoogle.library)?client=" + CLIENT;
	  s.setAttribute("data-ad-client", CLIENT);
	  if (test) s.setAttribute("data-adbreak-test", "on");
	  document.head.appendChild(s);
	  adConfig({ preloadAdBreaks: "on", sound: "on", onReady: function () { send({ id: null, event: "ready" }); } });
	  window.addEventListener("message", function (e) {
	    var d = e.data;
	    if (e.origin !== SITE || e.source !== parent || !d || d.type !== TYPE || d.v !== 1) return;
	    if (typeof d.id !== "string" || d.id.length > 64) return;
	    if (d.op === "break" && (d.name === "purse" || d.name === "review")) {
	      var id = d.id;
	      current = id;
	      show = null;
	      var say = function (event, status) {
	        if (current !== id) return;
	        var m = { id: id, event: event };
	        if (status !== undefined) m.breakStatus = String(status).slice(0, 32);
	        send(m);
	      };
	      adConfig({
	        type: "reward",
	        name: d.name,
	        beforeReward: function (f) { if (current === id) show = f; say("beforeReward"); },
	        beforeAd: function () { say("beforeAd"); },
	        afterAd: function () { say("afterAd"); },
	        adViewed: function () { say("adViewed"); },
	        adDismissed: function () { say("adDismissed"); },
	        adBreakDone: function (info) { say("done", info && info.breakStatus); if (current === id) { current = null; show = null; } }
	      });
	    } else if (d.op === "show" && d.id === current && show) {
	      var f = show;
	      show = null;
	      f();
	    }
	  });
	})();
	""")

// The ad document's policy, the one source of what it may load. No `sandbox` (the document needs
// its own origin's storage), no Trusted Types and no unsafe-eval (the run needed none), and it
// may be framed by the game's origin only. X-Frame-Options is none: it cannot name another origin.
_adsPolicy: strings.Join([
	"default-src 'none'",
	"base-uri 'none'",
	"object-src 'none'",
	"form-action 'none'",
	"script-src " + strings.Join(list.Concat([["'sha256-\(base64.Encode(null, sha256.Sum256(_adsBridge)))'"], _adsGoogle.script]), " "),
	"frame-src " + strings.Join(_adsGoogle.frame, " "),
	"connect-src " + strings.Join(_adsGoogle.connect, " "),
	"img-src " + strings.Join(_adsGoogle.img, " "),
	"style-src 'unsafe-inline'",
	"frame-ancestors \(adsense.site)",
], "; ")

// Named a publisher, the app names where its ads play and where their document is answered;
// then the ad document is made, the service that answers it, and the door lets the game frame it.
if adsense.publisher != "" {
	adsense: site:  !=""
	adsense: frame: !=""

	// What generate writes to ads/break.json, which the service answers /break with.
	adsense: break: {
		document: "<!doctype html>\n<meta charset=\"utf-8\">\n<title>Ad</title>\n<script>\(_adsBridge)</script>\n"
		csp:      _adsPolicy
	}

	// The game's door lets it frame the ad document (its CSP's frame-src, in the header and the
	// shell's <meta>); the door's frame-ancestors, which a <meta> cannot carry, is ads.nu's.
	code: capabilities: resources: adsFrame: {
		kind:   "frame"
		source: adsense.frame
		note:   "the ad document, which Google's ads play in (pronto-ads): its own origin, so no Google script runs in the game's"
	}

	// The service that answers the ad document: a deno server of the image standin's is, and its
	// route is the release's (a service's own host, straight to it, never through the door).
	cluster: surface: targets: ads: {
		srcs: globs: ["ads/server.ts", "ads/break.json"]
		expose: http: {port: _adsPort, env: "ADS_PORT"}
		// The image is deno's own, with no mise: its RUN goes unwrapped.
		activate: ""
		"process-compose": activate: "mise x --"
		entrypoint: {
			do:    "exec deno run --no-config --allow-net --allow-env --allow-read ads/server.ts"
			shell: "sh"
			dockerfile: {do: "deno run --no-config --allow-net --allow-env --allow-read /app/ads/server.ts", shell: "exec"}
			env: compose.environment
		}
		dockerfile: {
			from: name: "denoland/deno:debian-2.5.0"
			copy: [{srcs: ["ads/server.ts", "ads/break.json"], dst: "/app/ads/"}]
		}
		compose: {
			restart: "on-failure"
			environment: {ADS_PORT: "\(_adsPort)"}
		}
	}
}
