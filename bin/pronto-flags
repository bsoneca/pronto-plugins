#!/bin/sh
# Adds or refreshes pronto-flags in a pronto app:
#   bin/pronto-flags <app-dir>
# Or changes the released app's live flags, with no deploy (flags/live.nu):
#   bin/pronto-flags setup <app-dir>               # once: the bucket, its readers, the first push
#                                                  # (every write says its target, and takes --expect <url> or PRONTO_FLAGS_EXPECT;
#                                                  #  --dry-run or PRONTO_FLAGS_DRY_RUN=1 shows and writes nothing, refused at each write; each write is noted in the journal)
#   bin/pronto-flags push <app-dir> [--flip a,b|a=<value>] [--sync a,b] [--drop a,b] [--untested "<why>"] [--no-canary "<why>"]
#                                                  # the flags as flags_spec.cue says them now, merged over the live ones: --flip X turns X on live
#                                                  # (--flip X=<value> sets a bool, string or number; X=false turns it off), with the flag's cases, and
#                                                  # the flip is recorded into flags_spec.cue by a pull request the tool opens; --sync X writes the
#                                                  # spec's whole reach for X (accounts too); a live flag the spec dropped stays while
#                                                  # the served release reads it (released.json), unless --drop names it
#   bin/pronto-flags record <app-dir>              # the live flags into flags_spec.cue by a pull request (what a flip does after its write)
#   bin/pronto-flags drift <app-dir>               # what the spec says differently from live; exit 1 when it differs, 0 when equal
#   bin/pronto-flags released <app-dir>            # records which flags the served release reads (released.json beside the live
#                                                  # object); run from the clean released tree, by release-cron once it serves
#   bin/pronto-flags cases <app-dir> [flag]        # the cases a flip of each flag (or the one) runs
#   bin/pronto-flags history <app-dir> [--json]    # every version, newest first
#   bin/pronto-flags rollback <app-dir> [version]  # the version before the live one, or the one named
#   bin/pronto-flags show <app-dir>                # what a push would write, and where: nothing written
set -eu
here=$(cd "$(dirname "$0")/.." && pwd)
case "${1:-}" in
setup|push|released|history|rollback|show|cases|record|drift)
	cmd=$1
	app=$(cd "$2" && pwd)
	shift 2
	cd "$here"
	exec ./saytw --script tools.nu nu flags/live.nu "$cmd" "$app" "$@"
	;;
esac
app=$(cd "$1" && pwd)
shift
cd "$here"
# Deno as CI pins it for the plugins tree (.github/workflows/ci.yml).
exec ./saytw --script tools.nu mise exec deno@2.5.0 -- deno run --no-config --allow-read --allow-write flags/install.ts "$app" "$@"
