{
  "uid": "pronto-journeys",
  "title": "Journeys",
  "schemaVersion": 39,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "10s",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus"
      },
      {
        "name": "journey",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(journey:availability_budget, journey)",
        "multi": true,
        "includeAll": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "$journey",
      "repeat": "journey",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Availability (28d)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 3,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - journey:availability_errors:ratio_rate28d{journey=\"$journey\"}"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Error budget left",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              },
              {
                "color": "red",
                "value": -1e+9
              },
              {
                "color": "orange",
                "value": 0.2
              },
              {
                "color": "green",
                "value": 0.5
              }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - journey:availability_errors:ratio_rate28d{journey=\"$journey\"} / on(journey) journey:availability_budget"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Burn rate 1h",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "x",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 6
              }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "journey:availability_errors:ratio_rate1h{journey=\"$journey\"} / on(journey) journey:availability_budget"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Latency budget left",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "noValue": "no latency SLO",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              },
              {
                "color": "red",
                "value": -1e+9
              },
              {
                "color": "orange",
                "value": 0.2
              },
              {
                "color": "green",
                "value": 0.5
              }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - journey:latency_errors:ratio_rate28d{journey=\"$journey\"} / on(journey) journey:latency_budget"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Failed moments",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (moment) (increase(journey_moments_total{journey=\"$journey\",outcome=~\"refused|failed\"}[5m]))",
          "legendFormat": "{{moment}}"
        }
      ]
    }
  ]
}