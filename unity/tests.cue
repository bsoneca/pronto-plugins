package unity

import (
	"list"
	"encoding/json"
	"strings"
)

_t: #Host & {package: "myapp", surface: screens: table: {}}
_decl:     _t.files["unity_surface.cue"].text
_manifest: json.Unmarshal(_t.files["unity/unity.json"].text)

// An opt-in writes its declaration, the same as JSON for the host, and seeds each sheet it names.
written: [for p, f in _t.files if !f.seed {p}] & ["unity_surface.cue", "unity/unity.json"]
seeded: [for p, f in _t.files if f.seed {p}] & ["unity/screens/table.uss"]

// The declaration joins the app's package, and names nothing the program lacks: each screen's route
// and each hatch's kind are read from the program, so `cue vet` refuses an unknown one.
inPackage:        strings.Contains(_decl, "\npackage myapp\n") & true
screensOfProgram: strings.Contains(_decl, "routes: {for s, _ in unity.screens {(s): code.surface.screens[s].route}}") & true
hatchesOfProgram: strings.Contains(_decl, "code.capabilities.hatches[h].kind & \"host-dom\"") & true

// The defaults: a screen's look beside its name, no hatch, no scenario, every unit suite runs, none is the server's, no stack.
defaults: _manifest & {
	generated: "generated by pronto-unity from unity/host.cue — do not edit"
	screens: table: {uss: "unity/screens/table.uss", shared: []}
	hatches: [], scenarios: [], suites: {host: "all", server: {}}, cluster: false, stage: []
}
// The manifest is the declaration, nothing more.
sameAsDeclared: list.SortStrings([for k, _ in _manifest if k != "generated" {k}]) & ["cluster", "hatches", "scenarios", "screens", "stage", "suites"]

// Each sheet, hatch and scenario is named, never found: what the app lists is all the host reads.
_full: #Host & {package: "chess", surface: {
	screens: play: {uss: "unity/screens/play.uss", shared: ["unity/shared/board.uss"]}
	hatches: ["battle"]
	scenarios: ["unity/scenarios/board.cue"]
	suites: {host: ["rules", "match"], server: {gold: "SQL on PGlite"}}
	stage: ["hatch-src/src"]
}}
fullSeeded: [for p, f in _full.files if f.seed {p}] & ["unity/screens/play.uss", "unity/shared/board.uss"]
fullManifest: json.Unmarshal(_full.files["unity/unity.json"].text) & {hatches: ["battle"], scenarios: ["unity/scenarios/board.cue"], suites: {host: ["rules", "match"], server: {gold: "SQL on PGlite"}}, stage: ["hatch-src/src"]}

// A path never leaves the app, and a sheet is a .uss.
escapeRefused: [if (#Path & "../x") == _|_ {"refused"}, "accepted"][0] & "refused"
notUss: [if (#Surface & {screens: t: {uss: "unity/t.css", shared: []}, hatches: [], scenarios: [], suites: {host: "all", server: {}}, cluster: false, stage: []}) == _|_ {"refused"}, "accepted"][0] & "refused"

// A suite is run here or left to the server with its reason; a server suite with no reason is refused, and a list names suites.
noReason: [if (#Surface & {screens: t: {uss: "unity/t.uss", shared: []}, hatches: [], scenarios: [], suites: {host: [], server: {gold: ""}}, cluster: false, stage: []}) == _|_ {"refused"}, "accepted"][0] & "refused"
// The older flag still maps: cases=false is no suite here, cases=true all of them (export.cue, given or kept).
