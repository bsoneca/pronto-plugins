// generated by pronto-lessons from lessons/app/ — do not edit
package __PACKAGE__

import (
	"encoding/json"
	"list"
	"strings"
)

// The courses, each a #Course (lessons/schema.cue, beside this file in the app). On top of the schema: an id the
// row's id (`<account>/<course>/<chapter>`, at most 160 characters) can hold, a token the page can send (at most 64
// characters, the database's bound) and one the spec's quoting can hold (no `$spec$`); prices and rewards the hooks'
// integers hold.
lessons: courses: [ID=string]: #Course & {
	id: ID & strings.MaxRunes(60)
	hint: price: <=2147483647
	parts: [...{
		reward: <=2147483647
		bonus:  <=2147483647
		chapters: [...{
			id: strings.MaxRunes(60)
			moves: [...(string & strings.MaxRunes(64) & !~"[$]spec[$]")]
		}]
	}]
}

// A player's place in a chapter. Written only by the lessons functions (lessons.sql), which decide every
// move; a session reads its own rows and writes none.
code: state: entities: {
	LessonProgress: {
		table:      "lesson_progress"
		durability: "live"
		access: {scope: "private", owner: "owner_id"}
		fields: [
			// The account, the course and the chapter: "<account>/<course>/<chapter>".
			{ordinal: 1, name: "id", type: "text", pk: true, cel: "this.size() <= 160"},
			{ordinal: 2, name: "course", type: "text", cel: "this.size() <= 64"},
			{ordinal: 3, name: "chapter", type: "text", cel: "this.size() <= 64"},
			{ordinal: 4, name: "part", type: "text", cel: "this.size() <= 64"},
			// The ply the next move is expected at.
			{ordinal: 5, name: "step", type: "int64", cel: "this >= 0"},
			{ordinal: 6, name: "wrongs", type: "int64", cel: "this >= 0"},
			{ordinal: 7, name: "step_wrongs", type: "int64", cel: "this >= 0"},
			// The complaints said from the part's pool (the page's sequence keeps going after a reload).
			{ordinal: 8, name: "pool_said", type: "int64", cel: "this >= 0"},
			// The step a hint was bought at; -1 none.
			{ordinal: 9, name: "hinted", type: "int64", cel: "this >= -1"},
			{ordinal: 10, name: "done", type: "bool"},
			{ordinal: 11, name: "updated", type: "timestamp"},
			{ordinal: 12, name: "owner_id", type: "uuid", default: "auth_uid()"},
		]
	}
}

// The migration the app names (lessons_spec.cue): the ledger, the table's lock and the app's hooks' stubs.
// The functions the player calls are lessons.sql, a raw migration replayed at every release; the courses'
// own spec is `_lessonsOut.sql`.
_lessonsMigration: string
code: state: migrations: "\(_lessonsMigration)": operations: [{sql: up: _lessonsUp}]

// The two raw migrations, replayed every release (the app lists them in `code: state: rawMigrations`: pronto's generate does not
// own them): the courses' spec, written by `lessons write` from the courses, then the functions that read it. The names are
// stamped once in lessons_spec.cue, after the app's own, so the order holds under LC_ALL=C.
_lessonsRawNames: {spec: string, fns: string}
_lessonsRawMigrations: [
	{name: _lessonsRawNames.spec, src: "lessons/lessons_spec.sql"},
	{name: _lessonsRawNames.fns, src: "lessons/lessons.sql"},
]
// __LESSONS_RAW__

_lessonsUp: """
	CREATE SCHEMA IF NOT EXISTS lessons;
	REVOKE ALL ON SCHEMA lessons FROM PUBLIC;

	-- What was charged or paid, once an entry: the lessons functions insert here first and call the app's hook
	-- only when a row went in, so an entry is paid once whatever the hook does with a second call.
	CREATE TABLE IF NOT EXISTS lessons.paid (
	  owner uuid NOT NULL,
	  entry text NOT NULL,
	  kind text NOT NULL,
	  amount int NOT NULL,
	  at timestamptz NOT NULL DEFAULT now(),
	  PRIMARY KEY (owner, entry)
	);
	REVOKE ALL ON TABLE lessons.paid FROM PUBLIC;

	-- Only the role that owns the table (the one the lessons functions run as) writes it: no session role, and no service role.
	CREATE OR REPLACE FUNCTION lessons.progress_read_only() RETURNS trigger LANGUAGE plpgsql SET search_path = pg_catalog, pg_temp AS $f$
	BEGIN
	  IF current_user <> (SELECT pg_catalog.pg_get_userbyid(c.relowner) FROM pg_catalog.pg_class c WHERE c.oid = TG_RELID) THEN
	    RAISE EXCEPTION 'lesson progress is the lessons functions'' to write' USING ERRCODE = 'insufficient_privilege';
	  END IF;
	  RETURN coalesce(NEW, OLD);
	END $f$;
	DROP TRIGGER IF EXISTS lesson_progress_read_only ON public.lesson_progress;
	CREATE TRIGGER lesson_progress_read_only BEFORE INSERT OR UPDATE OR DELETE ON public.lesson_progress
	  FOR EACH ROW EXECUTE FUNCTION lessons.progress_read_only();

	-- The app's hooks (lessons/README.md): what a tier pays, how it pays and how it is rewarded. These stubs
	-- refuse until the app defines its own; one that exists is never replaced, whichever migration runs first.
	CREATE SCHEMA IF NOT EXISTS lessons_app;
	REVOKE ALL ON SCHEMA lessons_app FROM PUBLIC;
	DO $do$
	BEGIN
	  IF to_regprocedure('lessons_app.price(uuid)') IS NULL THEN
	    EXECUTE $stub$CREATE FUNCTION lessons_app.price(who uuid) RETURNS int LANGUAGE plpgsql AS $b$
	      BEGIN RAISE EXCEPTION 'lessons: the app defines lessons_app.price' USING ERRCODE = 'feature_not_supported'; END $b$$stub$;
	    EXECUTE 'REVOKE ALL ON FUNCTION lessons_app.price(uuid) FROM PUBLIC';
	  END IF;
	  IF to_regprocedure('lessons_app.pay(uuid, text, int)') IS NULL THEN
	    EXECUTE $stub$CREATE FUNCTION lessons_app.pay(who uuid, entry text, amount int) RETURNS void LANGUAGE plpgsql AS $b$
	      BEGIN RAISE EXCEPTION 'lessons: the app defines lessons_app.pay' USING ERRCODE = 'feature_not_supported'; END $b$$stub$;
	    EXECUTE 'REVOKE ALL ON FUNCTION lessons_app.pay(uuid, text, int) FROM PUBLIC';
	  END IF;
	  IF to_regprocedure('lessons_app.reward(uuid, text, int)') IS NULL THEN
	    EXECUTE $stub$CREATE FUNCTION lessons_app.reward(who uuid, entry text, amount int) RETURNS int LANGUAGE plpgsql AS $b$
	      BEGIN RAISE EXCEPTION 'lessons: the app defines lessons_app.reward' USING ERRCODE = 'feature_not_supported'; END $b$$stub$;
	    EXECUTE 'REVOKE ALL ON FUNCTION lessons_app.reward(uuid, text, int) FROM PUBLIC';
	  END IF;
	END $do$;
	NOTIFY pgrst, 'reload schema';
	"""

// What the courses become, written where their readers read them by `lessons write` (lessons.nu):
//   sql       lessons.spec(): what the database judges a move by (tokens, plies, prices, rewards), no words
//   js        the page's courses, every line a message key
//   messages  per locale, the lines of every key, as the entries of a messages/<locale>.json
//   courses   the courses' ids, whose `lesson_<id>_*` entries of a catalogue `lessons write` replaces
_lessonsOut: {
	courses: [for cid, _ in lessons.courses {cid}]
	sql: """
		-- generated by pronto-lessons from the app's lessons: courses — do not edit
		SET lock_timeout = '5s';
		SET statement_timeout = '30s';
		CREATE SCHEMA IF NOT EXISTS lessons;
		REVOKE ALL ON SCHEMA lessons FROM PUBLIC;
		CREATE OR REPLACE FUNCTION lessons.spec() RETURNS jsonb LANGUAGE sql IMMUTABLE AS $spec$
		  SELECT '\(strings.Replace(json.Marshal(_lessonsSpec), "'", "''", -1))'::jsonb
		$spec$;
		REVOKE ALL ON FUNCTION lessons.spec() FROM PUBLIC;

		"""
	js:  """
		// generated by pronto-lessons from the app's lessons: courses — do not edit
		// Each course as lessons/app/lessons.js reads it, every line a key of the message catalogue.
		export const courses = \(json.Indent(json.Marshal(_lessonsPage), "", "  "));

		"""
	messages: {for loc, _ in _lessonsLocales {
		(loc): strings.Join([for e in _lessonsEntries if e.line[loc] != _|_ {"  \(json.Marshal(e.key)): \(json.Marshal(e.line[loc]))"}], ",\n")
	}}
}

// The languages any course has.
_lessonsLocales: {for _, c in lessons.courses for l in c.locales {(l): true}}

// The database's spec: for each course its flag, hint price and parts, for each chapter its tokens, the ply its
// script starts at, and how many own wrong lines each ply has. No text a player reads.
_lessonsSpec: courses: {for cid, c in lessons.courses {(cid): {
	flag: c.flag
	hint: price: c.hint.price
	parts: [for p in c.parts {
		id:     p.id
		player: p.player
		reward: p.reward
		bonus:  p.bonus
		chapters: [for ch in p.chapters {
			id:    ch.id
			moves: ch.moves
			shown: ch.shown
			own: {for k, s in ch.steps if s.wrong != _|_ {(k): len(s.wrong)}}
		}]
	}]
}}}

// The page's courses: the schema's shape, each #Line a message key, and no move (PRONTO-1711).
_lessonsPage: {for cid, c in lessons.courses {(cid): {
	id:      c.id
	flag:    c.flag
	locales: c.locales
	hint:    c.hint
	parts: [for p in c.parts {
		id:      p.id
		teacher: p.teacher
		army:    p.army
		side:    p.side
		player:  p.player
		reward:  p.reward
		bonus:   p.bonus
		complaints: [for i, _ in p.complaints {"lesson_\(cid)_part_\(p.id)_complaint_\(i)"}]
		chapters: [for ch in p.chapters {
			id:    ch.id
			// How many plies the script has, never the moves: the database judges, and tells the page the plies played.
			plies: len(ch.moves)
			shown: ch.shown
			intro: "lesson_\(cid)_ch_\(ch.id)_intro"
			outro: "lesson_\(cid)_ch_\(ch.id)_outro"
			steps: {for k, s in ch.steps {(k): {
				if s.say != _|_ {say: "lesson_\(cid)_ch_\(ch.id)_\(k)_say"}
				if s.wrong != _|_ {wrong: [for i, _ in s.wrong {"lesson_\(cid)_ch_\(ch.id)_\(k)_wrong_\(i)"}]}
			}}}
		}]
	}]
}}}

// A key is one line of one course: two courses whose ids run into each other (`a` with a chapter `b_ch_c`, `a_ch_b` with
// a chapter `c`) would say the same key, so no two keys are the same.
_lessonsKeysUnique: [for e in _lessonsEntries {e.key}] & list.UniqueItems()

// Every key with its lines, one text per locale of its course.
_lessonsEntries: [
	for cid, c in lessons.courses for p in c.parts for i, l in p.complaints {key: "lesson_\(cid)_part_\(p.id)_complaint_\(i)", line: l},
	for cid, c in lessons.courses for p in c.parts for ch in p.chapters {key: "lesson_\(cid)_ch_\(ch.id)_intro", line: ch.intro},
	for cid, c in lessons.courses for p in c.parts for ch in p.chapters {key: "lesson_\(cid)_ch_\(ch.id)_outro", line: ch.outro},
	for cid, c in lessons.courses for p in c.parts for ch in p.chapters for k, s in ch.steps if s.say != _|_ {key: "lesson_\(cid)_ch_\(ch.id)_\(k)_say", line: s.say},
	for cid, c in lessons.courses for p in c.parts for ch in p.chapters for k, s in ch.steps if s.wrong != _|_ for i, l in s.wrong {key: "lesson_\(cid)_ch_\(ch.id)_\(k)_wrong_\(i)", line: l},
]
