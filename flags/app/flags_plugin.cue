// generated by pronto-flags from flags/app/ — do not edit
package __PACKAGE__

// Feature flags (pronto-flags): values the app reads while it runs, each with
// one value wherever it is released and, where it says, another wherever it
// runs at hand (a developer's launch, CI) and for the accounts it names.
// flags_spec.cue says them; flagd, OpenFeature's flag daemon, serves them
// beside the door over OpenFeature's remote evaluation protocol (OFREP), at
// /ofrep/ on the app's own origin. Where the app is released, flagd reads them
// live from a Cloud Storage object (flagsLive), so a flag changes with
// `pronto-flags push`, never a deploy.
#Flag: {
	// What the flag turns on or off, and why it is a flag.
	note?: string
	// Its value wherever the app is released.
	default!: bool | string | number
	// Its value wherever the door is reached at hand: localhost, 127.0.0.1,
	// or compose's `caddy`, as CI's checks reach it, and for `accounts`. Of
	// the default's kind.
	local?: bool | string | number
	if (default & bool) != _|_ {local?: bool}
	if (default & string) != _|_ {local?: string}
	if (default & number) != _|_ {local?: number}
	// The accounts that read `local` wherever the app runs: their ids, the
	// `sub` of their session's token, which the page sends as OpenFeature's
	// targetingKey. A page can name any account, so a flag opens a feature to
	// one and never guards it: what an account may do stays the database's.
	accounts?: [...string & =~"^[A-Za-z0-9_-]{1,64}$"]
}
#Flags: [=~"^[a-z][a-z0-9_-]{0,63}$"]: #Flag
flags: #Flags

// The hosts a door answers at hand. The door, not the page, says which host a
// request reached (flagd's --context-from-header): a page cannot claim one.
_flagsLocal: ["localhost", "127.0.0.1", "caddy"]

// flagd's flag definitions (https://flagd.dev/reference/flag-definitions/),
// which generate writes to flags/flags.json for the flagd image to carry.
flagd: document: {
	"$schema": "https://flagd.dev/schema/v0/flags.json"
	"flags": {
		for k, f in flags {
			"\(k)": {
				state: "ENABLED"
				variants: {
					default: f.default
					if f.local != _|_ {local: f.local}
					// The value a flag's accounts read: no accounts without one.
					if f.accounts != _|_ {local: f.local}
				}
				defaultVariant: "default"
				if f.local != _|_ && f.accounts == _|_ {
					targeting: {"if": [{"in": [{"var": "host"}, _flagsLocal]}, "local", "default"]}
				}
				if f.local != _|_ && f.accounts != _|_ {
					targeting: {"if": [{"in": [{"var": "host"}, _flagsLocal]}, "local", {"in": [{"var": "targetingKey"}, f.accounts]}, "local", "default"]}
				}
			}
		}
	}
}

// flagd's ports, clear of pronto-perf's 8687, pronto-billing's 8688 and the
// 8689 an app may hold for a service of its own: OFREP, the one the door proxies to, then
// evaluation, management and sync, all of them held in an instance whose
// containers share one network.
_flagdPorts: {ofrep: 8693, evaluation: 8694, management: 8695, sync: 8696}
// The flags baked into the image, which flagd serves until a later source
// says otherwise: where the app is released, the live object flagsLive names,
// given as FLAGD_SOURCES (flagd reads its options from FLAGD_* too, and a
// source there overrides the file's flags). No SSE stream held open: a page
// asks once, and reads a change on its next load. On a host launch the OFREP
// port is the one the launch hands out (FLAGD_OFREP_PORT), which the door's
// peer address names.
#FlagdArgs: {
	file: string
	ofrep: *"--ofrep-port \(_flagdPorts.ofrep) " | ""
	out:  "start --uri file:\(file) \(ofrep)--port \(_flagdPorts.evaluation) --management-port \(_flagdPorts.management) --sync-port \(_flagdPorts.sync) --ofrep-sse-enabled=false --context-from-header X-Pronto-Host=host"
}

// Where the released app's flags live: one object in a Cloud Storage bucket
// with versioning, whose versions are the flags' history and their rollback
// (`pronto-flags setup`, `push`, `history`, `rollback`). flags_spec.cue names
// the bucket and the project that holds it; release.cue hands flagd the source,
// spelled out (`sidecars: flagd: env: FLAGD_SOURCES: "<flagsLive.sources>"`),
// since a release reads that file alone, and flags_spec.cue holds the two to
// each other.
flagsLive?: {
	project!: =~"^[a-z][a-z0-9-]{4,28}[a-z0-9]$"
	bucket!:  =~"^[a-z0-9][a-z0-9_.-]{1,61}[a-z0-9]$"
	object:   *"flags.json" | =~"^[A-Za-z0-9_./-]+\\.json$"
	sources:  "[{\"uri\":\"gs://\(bucket)/\(object)\",\"provider\":\"gcs\"}]"
}

code: capabilities: hatches: flagd: {
	kind: "container"
	note: "pronto-flags' flagd: evaluates the app's feature flags (flags_spec.cue) over OFREP, behind the door's /ofrep/"
}

// The door proxies to it on a host launch too: pronto runs the program's host peers
// (code.meta.hostPeers, pronto 0.24.1-gcp.26) beside its own renderer.
code: meta: hostPeers: flagd: _flagdPorts.ofrep

cluster: surface: targets: flagd: {
	srcs: globs: ["flags/flags.json"]
	expose: http: {port: _flagdPorts.ofrep, env: "FLAGD_OFREP_PORT"}
	"process-compose": activate: "mise x --"
	entrypoint: {
		do:    "exec flagd \((#FlagdArgs & {file: "flags/flags.json", ofrep: ""}).out)"
		shell: "sh"
		// The image's binary, distroless: no shell to run it with.
		dockerfile: {do: "/flagd-build \((#FlagdArgs & {file: "/flags/flags.json"}).out)", shell: "exec"}
	}
	dockerfile: {
		from: name: "ghcr.io/open-feature/flagd:\(#FlagdVersion)"
		copy: [{srcs: ["flags/flags.json"], dst: "/flags/"}]
	}
	compose: restart: "on-failure"
}

#FlagdVersion: "v0.18.0"
